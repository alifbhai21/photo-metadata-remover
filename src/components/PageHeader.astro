---
import { getTranslations, t } from '../i18n/index';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  lang?: string;
}

const { eyebrow, title, subtitle, lang = 'en' } = Astro.props;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);

// Fall back to the i18n key "page.eyebrow" when nothing was passed explicitly.
const eyebrowText = eyebrow || t(translations, 'page.eyebrow');
---

<header class="max-w-3xl">
  {eyebrowText && (
    <span class="pmr-eyebrow">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent"></span>
      {eyebrowText}
    </span>
  )}
  <h1 class="mt-3 text-[32px] sm:text-[40px] font-semibold tracking-tight text-text leading-[1.1]">
    {title}
  </h1>
  {subtitle && (
    <p class="mt-4 text-[16px] sm:text-[17px] text-text-muted leading-relaxed">
      {subtitle}
    </p>
  )}
</header>
