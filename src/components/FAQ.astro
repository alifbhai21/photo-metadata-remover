---
import { getTranslations, t } from '../i18n/index';

const { lang = 'en', items } = Astro.props;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);

const faqItems: { question: string; answer: string }[] = Array.isArray(items) && items.length > 0
  ? items
  : Object.values(translations.faq?.questions ?? {}).map((q: any) => ({ question: q.question, answer: q.answer }));
---

<section id="faq" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 scroll-mt-24" data-purpose="faq-accordion">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <h2 class="text-2xl font-bold text-slate-900 tracking-tight">{t(translations, 'faq.title')}</h2>
    <a href={'/' + currentLang + '/faq'} class="text-xs font-semibold text-brand-700 hover:text-brand-800 inline-flex items-center gap-1">
      <span>{t(translations, 'faq.more')}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {faqItems.map((faq) => (
      <details class="group bg-white rounded-2xl p-5 border border-slate-200/80 [&_summary::-webkit-details-marker]:hidden cursor-pointer">
        <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-slate-800 min-h-[44px]">
          <span>{faq.question}</span>
          <span class="text-slate-400 group-open:rotate-45 transition-transform text-lg leading-none" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-xs text-slate-500 leading-relaxed border-t border-slate-100 pt-3">
          {faq.answer}
        </p>
      </details>
    ))}
  </div>
</section>
