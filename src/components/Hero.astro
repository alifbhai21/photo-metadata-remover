---
import { getTranslations, t } from '../i18n/index';

const { lang = 'en' } = Astro.props;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-12 overflow-hidden" data-purpose="hero-banner">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    <!-- Hero left column: headline & quick points -->
    <div class="lg:col-span-6 space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50 border border-brand-200 text-brand-800 text-xs font-semibold tracking-wide">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2z" />
        </svg>
        <span>{t(translations, 'hero.pill')}</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.1]">
        {t(translations, 'hero.title_a')} <span class="text-brand-700">{t(translations, 'hero.title_b')}</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-600 max-w-lg leading-relaxed font-normal">
        {t(translations, 'hero.tagline')}
      </p>
      <div class="pt-4 grid grid-cols-3 gap-3 max-w-lg border-t border-slate-100">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-full bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-700 shrink-0" aria-hidden="true">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" x2="12" y1="15" y2="3" />
            </svg>
          </div>
          <div class="leading-snug">
            <p class="text-xs font-bold text-slate-800">{t(translations, 'hero.props.local.title')}</p>
            <p class="text-[11px] text-slate-500">{t(translations, 'hero.props.local.sub')}</p>
          </div>
        </div>
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-full bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-700 shrink-0" aria-hidden="true">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
          </div>
          <div class="leading-snug">
            <p class="text-xs font-bold text-slate-800">{t(translations, 'hero.props.fast.title')}</p>
            <p class="text-[11px] text-slate-500">{t(translations, 'hero.props.fast.sub')}</p>
          </div>
        </div>
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-full bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-700 shrink-0" aria-hidden="true">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" x2="12" y1="8" y2="12" />
            </svg>
          </div>
          <div class="leading-snug">
            <p class="text-xs font-bold text-slate-800">{t(translations, 'hero.props.open.title')}</p>
            <p class="text-[11px] text-slate-500">{t(translations, 'hero.props.open.sub')}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Hero right column: before/after visual -->
    <div class="lg:col-span-6 relative flex items-center justify-center py-6">
      <div id="hero-fit" class="relative w-full max-w-lg flex items-center justify-between gap-4">
        <!-- Left card: original photo -->
        <div class="relative z-10 w-52 bg-white p-2.5 rounded-2xl shadow-xl border border-slate-100 rotate-[-4deg] transition-transform hover:rotate-0">
          <div class="h-36 rounded-xl overflow-hidden bg-gradient-to-br from-sky-100 via-slate-200 to-emerald-100" aria-hidden="true"></div><div class="mt-2.5 bg-white/95 backdrop-blur-sm rounded-xl p-2.5 shadow-md border border-slate-100 text-[10px] space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-4 h-4 rounded bg-brand-50 text-brand-700 flex items-center justify-center font-bold" aria-hidden="true">📷</span>
              <div class="min-w-0">
                <span class="text-slate-400 block text-[8px] leading-tight">{t(translations, 'hero.mock.camera')}</span>
                <span class="block h-1.5 mt-0.5 rounded bg-slate-300 w-14" aria-hidden="true"></span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-4 h-4 rounded bg-brand-50 text-brand-700 flex items-center justify-center font-bold" aria-hidden="true">📍</span>
              <div class="min-w-0">
                <span class="text-slate-400 block text-[8px] leading-tight">{t(translations, 'hero.mock.location')}</span>
                <span class="block h-1.5 mt-0.5 rounded bg-slate-300 w-14" aria-hidden="true"></span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-4 h-4 rounded bg-brand-50 text-brand-700 flex items-center justify-center font-bold" aria-hidden="true">🕒</span>
              <div class="min-w-0">
                <span class="text-slate-400 block text-[8px] leading-tight">{t(translations, 'hero.mock.date')}</span>
                <span class="block h-1.5 mt-0.5 rounded bg-slate-300 w-14" aria-hidden="true"></span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-4 h-4 rounded bg-brand-50 text-brand-700 flex items-center justify-center font-bold" aria-hidden="true">💻</span>
              <div class="min-w-0">
                <span class="text-slate-400 block text-[8px] leading-tight">{t(translations, 'hero.mock.software')}</span>
                <span class="block h-1.5 mt-0.5 rounded bg-slate-300 w-14" aria-hidden="true"></span>
              </div>
            </div>
            <div class="pt-1 text-[9px] text-red-500 font-semibold flex items-center gap-1">
              <span aria-hidden="true">⚠️</span>
              <span>{t(translations, 'hero.mock.more')}</span>
            </div>
          </div>
        </div>

        <!-- Transition arrow -->
        <div class="relative z-20 flex-shrink-0" aria-hidden="true">
          <div class="w-10 h-10 rounded-full bg-white shadow-md border border-slate-200 flex items-center justify-center text-brand-600">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <line x1="5" x2="19" y1="12" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </div>
        </div>

        <!-- Right card: clean photo with safe badge -->
        <div class="relative z-10 w-52 bg-white p-2.5 rounded-2xl shadow-xl border border-slate-100 rotate-[3deg] transition-transform hover:rotate-0">
          <div class="h-40 rounded-xl overflow-hidden bg-gradient-to-br from-sky-100 via-slate-200 to-brand-100" aria-hidden="true"></div>
          <div class="mt-2.5 bg-brand-50 border border-brand-200 rounded-xl p-2.5 flex items-center gap-2">
            <div class="w-5 h-5 rounded-full bg-brand-600 text-white flex items-center justify-center shrink-0" aria-hidden="true">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </div>
            <div>
              <p class="text-[11px] font-bold text-slate-800 leading-tight">{t(translations, 'hero.mock.clean_title')}</p>
              <p class="text-[9px] text-brand-700 font-semibold">{t(translations, 'hero.mock.clean_sub')}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Responsive rule: preserve the exact Stitch hero mockup composition (a single
  // row of two cards + arrow) on every viewport by proportionally scaling it when
  // the column is narrower than 512px. No stacking, no hiding, no relocation.
  const heroFit = document.getElementById('hero-fit');
  if (heroFit) {
    const applyHeroFit = () => {
      const parent = heroFit.parentElement;
      const parentWidth = parent ? parent.getBoundingClientRect().width : window.innerWidth;
      const k = Math.min(1, parentWidth / 512);
      heroFit.style.zoom = String(k);
    };
    applyHeroFit();
    window.addEventListener('resize', applyHeroFit);
  }
</script>