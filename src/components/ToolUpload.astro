---
import { getTranslations, t } from '../i18n/index';

const { lang = 'en' } = Astro.props;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);
---

<section id="tool" class="scroll-mt-24">
  <div class="w-full">
    <div id="a11y-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

    <!-- Upload zone — Stitch dashed dropzone -->
    <div
      id="upload-zone"
      role="button"
      tabindex="0"
      aria-label={t(translations, 'tool.upload_zone_label')}
      class="custom-dashed-border relative rounded-2xl p-8 sm:p-12 text-center flex flex-col items-center justify-center bg-slate-50/40 hover:bg-slate-50 transition-colors cursor-pointer group"
    >
      <input
        type="file"
        id="file-input"
        accept=".jpg,.jpeg,.png,.webp,.tif,.tiff,.heic,.heif"
        multiple
        class="sr-only"
      />

      <div id="upload-content" class="transition-opacity">
        <!-- Icon -->
        <div
          class="w-16 h-16 rounded-full bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-700 mb-5 group-hover:scale-105 transition-transform shadow-sm"
          aria-hidden="true"
        >
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
            <polyline points="12 12 12 16" />
            <polyline points="9 13 12 10 15 13" />
          </svg>
        </div>

        <!-- Title & subtitle -->
        <h3 class="text-xl font-bold text-slate-800 tracking-tight mb-1">
          {t(translations, 'tool.upload_title')}
        </h3>
        <p class="text-xs text-slate-500 mb-3">
          {t(translations, 'tool.upload_subtitle')}
        </p>
        <p class="text-[11px] text-slate-400 font-medium mb-6">
          {t(translations, 'tool.formats_line')}
        </p>

        <!-- Choose photos CTA -->
        <span
          class="inline-flex items-center gap-2.5 bg-brand-800 hover:bg-brand-900 text-white font-semibold px-6 py-3 rounded-xl shadow-md transition-all"
          aria-hidden="true"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
          </svg>
          <span>{t(translations, 'tool.choose_photos')}</span>
        </span>
      </div>

      <!-- Drag active state -->
      <div id="drag-active" class="hidden absolute inset-0 bg-brand-50/95 backdrop-blur-sm rounded-2xl flex flex-col items-center justify-center pointer-events-none">
        <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-600 text-white mb-3" aria-hidden="true">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
            <polyline points="12 12 12 16" />
            <polyline points="9 13 12 10 15 13" />
          </svg>
        </div>
        <div class="text-text font-medium text-[15px] tracking-tight">
          {t(translations, 'tool.drag_active')}
        </div>
      </div>
    </div>

    <!-- Upload validation errors (invalid/oversized files shown when rejected) -->
    <div
      id="upload-error"
      role="alert"
      tabindex="-1"
      class="hidden mt-4 px-4 py-3 bg-danger-bg border border-danger-border text-[13.5px] text-danger-text rounded-xl whitespace-pre-line"
    ></div>

    <!-- Processing status — calm indeterminate indicator -->
    <div id="processing-status" class="hidden mt-6 p-4 sm:p-5 bg-surface rounded-xl border border-border pmr-elev-1">
      <div class="flex items-center gap-3">
        <div class="relative w-5 h-5" aria-hidden="true">
          <span class="absolute inset-0 rounded-full border-2 border-accent-soft"></span>
          <span class="absolute inset-0 rounded-full border-2 border-accent border-t-transparent animate-spin"></span>
        </div>
        <div class="flex flex-col">
          <span class="text-[13.5px] text-text font-medium tracking-tight">
            {t(translations, 'tool.removing_metadata')}
          </span>
          <div class="mt-2 w-32 pmr-progress-shimmer" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <!-- Processing progress (upload → scan → remove → download) -->
    <ol
      id="progress-steps"
      class="hidden mt-6 pmr-card p-4 sm:p-5"
      aria-label={t(translations, 'tool.progress_label')}
    >
      <li data-step="1" class="flex items-center flex-1">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-[11px] font-mono font-medium border bg-surface-muted text-text-muted border-border" data-step-check aria-hidden="true">1</span>
        <span class="ml-2 text-[12.5px] font-medium text-text-muted tracking-tight">{t(translations, 'tool.step_upload')}</span>
        <span class="ml-3 flex-1 h-px bg-border" data-step-line aria-hidden="true"></span>
      </li>
      <li data-step="2" class="flex items-center flex-1">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-[11px] font-mono font-medium border bg-surface-muted text-text-muted border-border" data-step-check aria-hidden="true">2</span>
        <span class="ml-2 text-[12.5px] font-medium text-text-muted tracking-tight">{t(translations, 'tool.step_scan')}</span>
        <span class="ml-3 flex-1 h-px bg-border" data-step-line aria-hidden="true"></span>
      </li>
      <li data-step="3" class="flex items-center flex-1">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-[11px] font-mono font-medium border bg-surface-muted text-text-muted border-border" data-step-check aria-hidden="true">3</span>
        <span class="ml-2 text-[12.5px] font-medium text-text-muted tracking-tight">{t(translations, 'tool.step_remove')}</span>
        <span class="ml-3 flex-1 h-px bg-border" data-step-line aria-hidden="true"></span>
      </li>
      <li data-step="4" class="flex items-center">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-[11px] font-mono font-medium border bg-surface-muted text-text-muted border-border" data-step-check aria-hidden="true">4</span>
        <span class="ml-2 text-[12.5px] font-medium text-text-muted tracking-tight">{t(translations, 'tool.step_download')}</span>
      </li>
    </ol>

    <!-- Results panel -->
    <div id="results-panel" class="hidden mt-6 pmr-card overflow-hidden pmr-elev-1">
      <div class="px-4 sm:px-5 py-4 border-b border-border">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <h3 id="results-heading" tabindex="-1" class="text-[14.5px] font-semibold text-text tracking-tight">
            {t(translations, 'tool.scan_results')}
          </h3>
          <div class="flex flex-wrap gap-2">
            <button
              id="reset-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-surface text-text text-[12.5px] font-medium rounded-full border border-border hover:bg-surface-muted transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2" />
              </svg>
              {t(translations, 'tool.reset')}
            </button>
            <button
              id="remove-all-btn"
              type="button"
              class="hidden inline-flex items-center gap-1.5 px-3.5 py-2 bg-accent-btn text-accent-btn-text text-[12.5px] font-medium rounded-full hover:bg-accent-btn-hover transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
            >
              {t(translations, 'tool.remove_all')}
            </button>
            <button
              id="download-all-btn"
              type="button"
              class="hidden inline-flex items-center gap-1.5 px-3.5 py-2 bg-accent-btn text-accent-btn-text text-[12.5px] font-medium rounded-full hover:bg-accent-btn-hover transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              {t(translations, 'tool.download_zip')}
            </button>
            <button
              id="show-metadata-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-surface text-text text-[12.5px] font-medium rounded-full border border-border hover:bg-surface-muted transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
              aria-expanded="false"
              aria-controls="metadata-viewer-panel"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              {t(translations, 'tool.show_metadata')}
            </button>
          </div>
        </div>
      </div>

      <!-- Global processing/success/error status (batch result banner) -->
      <div id="global-status" class="hidden"></div>
      
        <div id="files-list" class="divide-y divide-border" 
        data-fields-found={t(translations, 'tool.metadata_fields')}
        data-download={t(translations, 'tool.download_clean')}
        data-download-zip={t(translations, 'tool.download_zip')}
        data-creating-zip={t(translations, 'tool.creating_zip')}
        data-zip-error={t(translations, 'tool.zip_error')}
        data-remove={t(translations, 'tool.remove_selected')}
        data-remove-all={t(translations, 'tool.remove_all')}
        data-error={t(translations, 'tool.error')}
        data-unsupported-file={t(translations, 'tool.unsupported_file')}
        data-file-too-large={t(translations, 'tool.file_too_large')}
        data-no-metadata={t(translations, 'tool.no_metadata')}
        data-processing={t(translations, 'tool.processing')}
        data-removing={t(translations, 'tool.removing')}
        data-removing-metadata={t(translations, 'tool.removing_metadata')}
        data-scanning={t(translations, 'tool.scanning')}
        data-scanning-progress={t(translations, 'tool.scanning_progress')}
        data-success-all={t(translations, 'tool.success_all')}
        data-success-file={t(translations, 'tool.success_file')}
        data-partial-success={t(translations, 'tool.partial_success')}
        data-error-all={t(translations, 'tool.error_all')}
        data-try-again={t(translations, 'tool.try_again')}
        data-file-failed={t(translations, 'tool.file_failed')}
        data-files-cleaned={t(translations, 'tool.files_cleaned')}
        data-failed-to-remove={t(translations, 'tool.failed_to_remove')}
        data-unit-bytes={t(translations, 'units.bytes')}
        data-unit-kb={t(translations, 'units.kb')}
        data-unit-mb={t(translations, 'units.mb')}
        data-unit-gb={t(translations, 'units.gb')}
        data-unit-zero={t(translations, 'units.zero')}
        data-show-metadata={t(translations, 'tool.show_metadata')}
        data-hide-metadata={t(translations, 'tool.hide_metadata')}
        data-show-technical-info={t(translations, 'tool.show_technical_info')}
        data-hide-technical-info={t(translations, 'tool.hide_technical_info')}
        data-metadata-for={t(translations, 'tool.metadata_for')}
        data-gps-detected={t(translations, 'tool.gps_detected')}
        data-gps-location={t(translations, 'tool.gps_location')}
        data-no-metadata-found={t(translations, 'tool.no_metadata_found')}
        data-field-name={t(translations, 'tool.field_name')}
        data-field-value={t(translations, 'tool.field_value')}
        data-binary-present={t(translations, 'tool.binary_present')}
        data-metadata-panel-title={t(translations, 'tool.metadata_panel_title')}
        data-metadata-empty={t(translations, 'tool.metadata_empty')}
        data-close-metadata={t(translations, 'tool.close_metadata')}
        data-metadata-summary={t(translations, 'tool.metadata_summary')}
        data-no-privacy-metadata-found={t(translations, 'metadata.no_privacy_metadata_found')}
        data-privacy-metadata-found={t(translations, 'metadata.privacy_metadata_found')}
        data-no-privacy-metadata={t(translations, 'metadata.no_privacy_metadata_found')}
        data-technical-image-info={t(translations, 'metadata.technical_image_info')}
        data-technical-preserved={t(translations, 'metadata.technical_preserved')}
        data-technical-properties={t(translations, 'metadata.technical_properties')}
        data-privacy-metadata-remaining={t(translations, 'metadata.privacy_metadata_remaining')}
        data-verifying-clean-output={t(translations, 'metadata.verifying_clean_output')}
        data-verification-failed={t(translations, 'metadata.verification_failed')}
        data-privacy-metadata-section={t(translations, 'metadata.privacy_metadata')}
        data-scan-results={t(translations, 'tool.scan_results')}
        data-a11y-zip-ready={t(translations, 'tool.a11y_zip_ready')}>
        <!-- Files will be added here dynamically -->
      </div>

      <!-- Metadata viewer panel (expandable) -->
      <div id="metadata-viewer-panel" class="hidden" role="region" aria-label={t(translations, 'tool.metadata_panel_title')}>
        <div class="border-t border-border">
          <div class="p-4 sm:p-5">
            <div class="flex items-center justify-between mb-4">
              <h4 class="text-[13.5px] font-semibold text-text tracking-tight">{t(translations, 'tool.metadata_panel_title')}</h4>
              <button
                id="close-metadata-btn"
                type="button"
                class="inline-flex items-center gap-1 text-[12.5px] text-text-muted hover:text-text transition-colors px-2.5 py-1 rounded-md hover:bg-surface-muted"
                aria-label={t(translations, 'tool.close_metadata')}
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                {t(translations, 'tool.close_metadata')}
              </button>
            </div>
            <div id="metadata-viewer-content" class="space-y-3">
              <!-- Metadata content rendered dynamically -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { trackEvent } from '../lib/analytics';
  import { stripTiffMetadata } from '../lib/tiff';
  import { findOutputPrivacyFindings } from '../lib/verify';
  import { normalizeWebpExifPayload, stripWebpMetadata } from '../lib/webp';

  const MAX_CONCURRENT_STRIP = 3;

  async function runWithConcurrency<T>(
    tasks: (() => Promise<T>)[],
    limit: number,
  ): Promise<void> {
    let index = 0;
    let active = 0;
    let resolve!: () => void;
    const done = new Promise<void>((r) => (resolve = r));

    function next() {
      while (active < limit && index < tasks.length) {
        const i = index++;
        active++;
        tasks[i]().finally(() => {
          active--;
          if (active === 0 && index >= tasks.length) resolve();
          else next();
        });
      }
      if (tasks.length === 0) resolve();
    }

    next();
    return done;
  }

  const uploadZone = document.getElementById('upload-zone');
  const fileInput = document.getElementById('file-input');
  const dragActive = document.getElementById('drag-active');
  const uploadContent = document.getElementById('upload-content');
  const processingStatus = document.getElementById('processing-status');
  const resultsPanel = document.getElementById('results-panel');
  const filesList = document.getElementById('files-list');
  const removeAllBtn = document.getElementById('remove-all-btn');
  const downloadAllBtn = document.getElementById('download-all-btn');
  const resetBtn = document.getElementById('reset-btn');
  const globalStatusEl = document.getElementById('global-status');
  const uploadErrorEl = document.getElementById('upload-error');
  const showMetadataBtn = document.getElementById('show-metadata-btn');
  const metadataViewerPanel = document.getElementById('metadata-viewer-panel');
  const metadataViewerContent = document.getElementById('metadata-viewer-content');
  const closeMetadataBtn = document.getElementById('close-metadata-btn');
  const a11yStatusEl = document.getElementById('a11y-status');
  const progressSteps = document.getElementById('progress-steps');
  const resultsHeading = document.getElementById('results-heading');

  document.body?.setAttribute('data-pmr-ready', '1');

  const VALID_TYPES = ['image/jpeg', 'image/png', 'image/webp', 'image/tiff', 'image/heic', 'image/heif'];

  function isHeicFile(file: File): boolean {
    if (file.type === 'image/heic' || file.type === 'image/heif') return true;
    return /\.(heic|heif)$/i.test(file.name);
  }

  // TIFF cannot be decoded by Chromium (<img>/createImageBitmap), so it is
  // detected by type or extension and handled by the byte-level TIFF path.
  function isTiffFile(file: File): boolean {
    if (file.type === 'image/tiff' || file.type === 'image/tif') return true;
    return /\.(tif|tiff)$/i.test(file.name);
  }

  async function isAvifFile(file: File): Promise<boolean> {
    try {
      const head = new Uint8Array(await withTimeout(file.slice(0, 16).arrayBuffer(), STRIP_TIMEOUT_MS));
      if (head.length < 12) return false;
      const isFtyp = head[4] === 0x66 && head[5] === 0x74 && head[6] === 0x79 && head[7] === 0x70;
      if (!isFtyp) return false;
      const brand = String.fromCharCode(head[8], head[9], head[10], head[11]);
      return brand === 'avif' || brand === 'avis' || file.type === 'image/avif';
    } catch {
      return false;
    }
  }

  async function validateJpegBlob(blob: Blob): Promise<void> {
    if (!blob || blob.size === 0) {
      throw new Error('Encoded image is empty');
    }
    if (blob.type && blob.type !== 'image/jpeg') {
      throw new Error('Encoded image has an incorrect type: ' + blob.type);
    }
    const head = new Uint8Array(await withTimeout(blob.slice(0, 3).arrayBuffer(), STRIP_TIMEOUT_MS));
    if (head.length < 3 || head[0] !== 0xff || head[1] !== 0xd8 || head[2] !== 0xff) {
      throw new Error('Encoded image is not a JPEG (missing SOI marker)');
    }
    const outBmp = await withTimeout(createImageBitmap(blob), STRIP_TIMEOUT_MS);
    try {
      if (!outBmp.width || !outBmp.height) {
        throw new Error('Encoded JPEG has zero dimensions');
      }
      if (outBmp.width > 16384 || outBmp.height > 16384) {
        throw new Error('Encoded JPEG dimensions are implausible');
      }
    } finally {
      outBmp.close();
    }
  }

  const MAX_FILE_SIZE_BYTES = 40 * 1024 * 1024;

  type UploadRejection = { name: string; reason: 'unsupported' | 'too-large' };

  function validateUploadFile(file: File): UploadRejection | null {
    if (!VALID_TYPES.includes(file.type) && !isHeicFile(file) && !isTiffFile(file)) {
      return { name: file.name, reason: 'unsupported' };
    }
    if (file.size > MAX_FILE_SIZE_BYTES) {
      return { name: file.name, reason: 'too-large' };
    }
    return null;
  }

  function showUploadErrors(rejections: UploadRejection[]) {
    if (!uploadErrorEl) return;
    if (rejections.length === 0) {
      uploadErrorEl.textContent = '';
      uploadErrorEl.classList.add('hidden');
      return;
    }
    const ds = filesList?.dataset || {};
    const maxSize = formatFileSize(MAX_FILE_SIZE_BYTES);
    const messages = rejections.map((r) => {
      if (r.reason === 'too-large') {
        const template = ds.fileTooLarge || '{{name}} is too large (max {{size}})';
        return template.replace('{{name}}', r.name).replace('{{size}}', maxSize);
      }
      const template = ds.unsupportedFile || 'Unsupported file type: {{name}}';
      return template.replace('{{name}}', r.name);
    });
    uploadErrorEl.textContent = messages.join('\n');
    uploadErrorEl.classList.remove('hidden');
    uploadErrorEl.focus();
  }

  let globalStatus: 'idle' | 'processing' | 'success' | 'partial-error' | 'error' = 'idle';

  /**
   * Post-removal verification state of a file item. The generated output is
   * re-scanned before the UI is allowed to claim anything about it:
   *   - 'unverified': no clean output yet (or a new removal started)
   *   - 'verifying' : the generated output is being re-read and re-scanned
   *   - 'passed'    : the generated bytes were re-parsed, no privacy field and
   *                   no privacy container left
   *   - 'remaining' : the generated bytes still contain privacy fields (count)
   *   - 'failed'    : the generated output could not be confirmed clean/verified
   */
  type VerificationStatus = 'unverified' | 'verifying' | 'passed' | 'remaining' | 'failed';

  interface FileItem {
    id: number;
    file: File;
    metadata: Record<string, unknown>;
    cleanBlob: Blob | null;
    cleanExt: string;
    status: 'clean' | 'error';
    error?: boolean;
    busy: boolean;
    verifyStatus: VerificationStatus;
    /**
     * Privacy fields the classifier found in the GENERATED output. Always
     * derived from the re-scanned clean bytes - never a constant.
     */
    remainingPrivacyMetadata: number;
  }

  let fileItems: FileItem[] = [];
  let nextId = 1;
  let busyCount = 0;
  let batchId = 0;
  let metadataViewerOpen = false;
  let zipBusy = false;

  function announce(message: string) {
    if (!a11yStatusEl) return;
    a11yStatusEl.textContent = '';
    setTimeout(() => {
      a11yStatusEl.textContent = message;
    }, 50);
  }

  const STAGE_INDEX = { upload: 1, scan: 2, remove: 3, download: 4 };

  function updateProgress() {
    if (!progressSteps) return;
    const steps = progressSteps.querySelectorAll('[data-step]');
    const hasFiles = fileItems.length > 0;
    const processing = resultsPanel ? resultsPanel.classList.contains('hidden') : false;
    const allDone = hasFiles && fileItems.every((f) => f.error || f.cleanBlob !== null);

    let active: number;
    let completed: number;
    if (!hasFiles) {
      active = STAGE_INDEX.upload;
      completed = 0;
    } else if (processing) {
      active = STAGE_INDEX.scan;
      completed = STAGE_INDEX.upload;
    } else if (allDone) {
      active = STAGE_INDEX.download;
      completed = STAGE_INDEX.download;
    } else {
      active = STAGE_INDEX.remove;
      completed = STAGE_INDEX.scan;
    }

    progressSteps.classList.toggle('hidden', !hasFiles);

    steps.forEach((step) => {
      const num = Number((step as HTMLElement).dataset.step || 0);
      const isActive = num === active;
      const isDone = hasFiles && num <= completed;
      const check = step.querySelector('[data-step-check]') as HTMLElement | null;

      if (isActive) {
        step.setAttribute('aria-current', 'step');
      } else {
        step.removeAttribute('aria-current');
      }
      if (check) {
        check.classList.toggle('opacity-40', num > active);
        check.textContent = isDone ? `✓ ${num}` : String(num);
        check.setAttribute('aria-hidden', 'true');
        check.classList.toggle('border-accent', isDone);
        check.classList.toggle('text-accent', isDone);
      }
    });
  }

  uploadZone?.addEventListener('click', () => {
    fileInput?.click();
  });

  uploadZone?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    e.preventDefault();
    fileInput?.click();
  });

  uploadZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dragActive?.classList.remove('hidden');
    uploadContent?.classList.add('opacity-50');
  });

  uploadZone?.addEventListener('dragleave', () => {
    dragActive?.classList.add('hidden');
    uploadContent?.classList.remove('opacity-50');
  });

  uploadZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dragActive?.classList.add('hidden');
    uploadContent?.classList.remove('opacity-50');
    const files = e.dataTransfer?.files;
    if (files && files.length) {
      handleFiles(files);
    }
  });

  fileInput?.addEventListener('change', (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (files && files.length) {
      handleFiles(files);
      if (fileInput) fileInput.value = '';
    }
  });

  async function handleFiles(files: FileList) {
    batchId++;
    processingStatus?.classList.remove('hidden');
    const scanTextEl = processingStatus?.querySelector('span');
    if (scanTextEl) scanTextEl.textContent = filesList?.dataset.removingMetadata || 'Removing metadata\u2026';
    resultsPanel?.classList.add('hidden');
    announce(filesList?.dataset.processing || '');
    revokeAllPreviews();
    if (filesList) filesList.innerHTML = '';
    fileItems = [];
    nextId = 1;
    busyCount = 0;
    setGlobalStatus('idle');
    resetZipState();
    closeMetadataViewer();
    if (removeAllBtn) removeAllBtn.textContent = filesList?.dataset.removeAll || 'Remove all metadata';

    const items: FileItem[] = [];
    const rejections: UploadRejection[] = [];
    const selectedFiles = Array.from(files);
    const thisBatchId = batchId;

    const scanText = processingStatus?.querySelector('span');
    let scanned = 0;
    for (const file of selectedFiles) {
      const rejection = validateUploadFile(file);
      if (rejection) {
        rejections.push(rejection);
        continue;
      }

      scanned++;
      if (scanText) {
        scanText.textContent = selectedFiles.length === 1
          ? (filesList?.dataset.scanning || 'Scanning photos\u2026')
          : (filesList?.dataset.scanningProgress || 'Scanning {{current}} of {{total}}\u2026')
              .replace('{{current}}', String(scanned))
              .replace('{{total}}', String(selectedFiles.length));
      }
      announce(scanText?.textContent || '');

      const item: FileItem = {
        id: nextId++,
        file,
        metadata: {},
        cleanBlob: null,
        cleanExt: isHeicFile(file) ? 'jpg' : isTiffFile(file) ? 'tiff' : extFromType(file.type),
        status: 'clean',
        error: false,
        busy: false,
        verifyStatus: 'unverified',
        remainingPrivacyMetadata: 0,
      };

      try {
        const arrayBuffer = await file.arrayBuffer();
        const exifr = await import('exifr');
        const data = await parseMetadataForFileType(arrayBuffer, file.type, exifr);
        item.metadata = data && typeof data === 'object' ? data : {};
      } catch (err) {
        console.error('Error parsing metadata:', err);
        item.metadata = {};
      }

      if (thisBatchId !== batchId) return;
      items.push(item);
    }

    if (thisBatchId !== batchId) return;
    fileItems = items;
    showUploadErrors(rejections);

    trackEvent('file_upload', { count: fileItems.length });
    trackEvent('scan_complete', {
      total: fileItems.length,
      with_metadata: fileItems.filter((f) => countPrivacyFields(f.metadata) > 0).length,
    });

    processingStatus?.classList.add('hidden');

    if (fileItems.length === 0) {
      resultsPanel?.classList.add('hidden');
      updateProgress();
      return;
    }

    resultsPanel?.classList.remove('hidden');
    updateProgress();
    renderFiles();
    resultsHeading?.focus();
  }

  function renderFiles() {
    if (!filesList) return;
    filesList.innerHTML = '';
    revokeAllPreviews();
    const autoStripItems: FileItem[] = [];

    fileItems.forEach((item) => {
      const fileItem = document.createElement('div');
      fileItem.className = 'p-4 sm:p-5 flex items-start sm:items-center gap-3 sm:gap-4 flex-col sm:flex-row pmr-fade-in';
      fileItem.dataset.id = String(item.id);

      let preview: HTMLImageElement | HTMLDivElement;
      if (isHeicFile(item.file)) {
        const heicPlaceholder = document.createElement('div');
        heicPlaceholder.className =
          'w-14 h-14 sm:w-16 sm:h-16 shrink-0 rounded-xl flex items-center justify-center bg-surface-strong border border-border text-[10.5px] font-mono font-medium text-text-muted tracking-wide';
        heicPlaceholder.textContent = 'HEIC';
        preview = heicPlaceholder;
      } else if (isTiffFile(item.file)) {
        // Chromium cannot render TIFF in an <img>, so show a format chip
        // exactly like the existing HEIC placeholder.
        const tiffPlaceholder = document.createElement('div');
        tiffPlaceholder.className =
          'w-14 h-14 sm:w-16 sm:h-16 shrink-0 rounded-xl flex items-center justify-center bg-surface-strong border border-border text-[10.5px] font-mono font-medium text-text-muted tracking-wide';
        tiffPlaceholder.textContent = 'TIFF';
        preview = tiffPlaceholder;
      } else {
        const img = document.createElement('img');
        img.className = 'w-14 h-14 sm:w-16 sm:h-16 object-cover rounded-xl border border-border shrink-0';
        const url = URL.createObjectURL(item.file);
        previewUrls.add(url);
        img.src = url;
        preview = img;
      }

      const info = document.createElement('div');
      info.className = 'flex-1 min-w-0 w-full sm:w-auto';

      const nameEl = document.createElement('div');
      nameEl.className = 'text-[14px] font-medium text-text truncate tracking-tight';
      nameEl.textContent = item.file.name;

      const sizeEl = document.createElement('div');
      sizeEl.className = 'text-[12.5px] text-text-faint font-mono mt-0.5';
      sizeEl.textContent = formatFileSize(item.file.size);

      const statusEl = document.createElement('div');
      statusEl.className = 'text-[12.5px] mt-1.5 leading-relaxed';

      info.appendChild(nameEl);
      info.appendChild(sizeEl);
      info.appendChild(statusEl);

      const actions = document.createElement('div');
      actions.className = 'flex gap-2 flex-wrap w-full sm:w-auto';

      const removeBtn = document.createElement('button');
      removeBtn.id = `remove-${item.id}`;
      removeBtn.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 text-[12.5px] bg-accent-btn text-accent-btn-text rounded-full font-medium hover:bg-accent-btn-hover transition-colors disabled:opacity-40 disabled:cursor-not-allowed';
      removeBtn.textContent = filesList?.dataset.remove || 'Remove metadata';
      removeBtn.onclick = () => removeMetadata(item.id);

      const downloadBtn = document.createElement('button');
      downloadBtn.id = `download-${item.id}`;
      downloadBtn.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 text-[12.5px] bg-surface text-text rounded-full font-medium border border-border hover:bg-surface-muted transition-colors disabled:opacity-40 disabled:cursor-not-allowed';
      downloadBtn.textContent = filesList?.dataset.download || 'Download clean image';
      downloadBtn.disabled = true;
      downloadBtn.onclick = () => downloadItem(item.id);

      const metaToggleBtn = document.createElement('button');
      metaToggleBtn.id = `meta-toggle-${item.id}`;
      metaToggleBtn.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 text-[12.5px] bg-surface text-text rounded-full font-medium border border-border hover:bg-surface-muted transition-colors disabled:opacity-40 disabled:cursor-not-allowed';
      const hasMetadata = Object.keys(item.metadata).length > 0;
      const hasPrivacyMetadata = hasMetadata && filterMetadata(item.metadata).some(e => e.privacy);
      if (!hasMetadata) {
        metaToggleBtn.textContent = filesList?.dataset.noMetadataFound || 'No metadata';
      } else if (hasPrivacyMetadata) {
        metaToggleBtn.textContent = filesList?.dataset.showMetadata || 'Show metadata';
      } else {
        metaToggleBtn.textContent = filesList?.dataset.showTechnicalInfo || 'Show technical info';
      }
      metaToggleBtn.disabled = !hasMetadata;
      metaToggleBtn.setAttribute('aria-expanded', 'false');
      metaToggleBtn.onclick = () => toggleFileMetadata(item.id);

      actions.appendChild(removeBtn);
      actions.appendChild(downloadBtn);
      actions.appendChild(metaToggleBtn);

      fileItem.appendChild(preview);
      fileItem.appendChild(info);
      fileItem.appendChild(actions);
      filesList.appendChild(fileItem);

      updateItemStatus(item, statusEl, downloadBtn, removeBtn);

      if (!item.error && Object.keys(item.metadata).length === 0 && item.cleanBlob === null) {
        autoStripItems.push(item);
      }
    });

    if (autoStripItems.length > 0) {
      const tasks = autoStripItems.map((item) => () => stripMetadata(item));
      runWithConcurrency(tasks, MAX_CONCURRENT_STRIP);
    }

    refreshActions();
  }

  const previewUrls = new Set<string>();
  function revokeAllPreviews() {
    previewUrls.forEach((u) => URL.revokeObjectURL(u));
    previewUrls.clear();
  }

  function setStatusLines(el: HTMLElement, lines: string[]) {
    el.innerHTML = '';
    for (const line of lines) {
      const span = document.createElement('span');
      span.className = 'block';
      span.textContent = line;
      el.appendChild(span);
    }
  }

  function updateItemStatus(
    item: FileItem,
    statusEl: HTMLElement,
    downloadBtn: HTMLButtonElement,
    removeBtn: HTMLButtonElement
  ) {
    const noMetadata = filesList?.dataset.noPrivacyMetadata || 'No privacy metadata found';
    const fieldsFound = filesList?.dataset.privacyMetadataFound || 'Privacy metadata found';
    const removeLabel = filesList?.dataset.remove || 'Remove metadata';
    const remainingTemplate = filesList?.dataset.privacyMetadataRemaining || 'Privacy metadata remaining: {{count}}';
    const remainingLine = (count: number) => remainingTemplate.replace('{{count}}', String(count));

    if (item.error) {
      if (item.verifyStatus === 'remaining' || item.verifyStatus === 'failed') {
        // The removal produced an output, but re-scanning that output did not
        // confirm it is clean. Report the real finding - never a zero.
        const verifyFailed = filesList?.dataset.verificationFailed || 'Verification failed';
        const lines = [`✕ ${verifyFailed}`];
        if (item.verifyStatus === 'remaining') {
          lines.push(remainingLine(item.remainingPrivacyMetadata));
        }
        setStatusLines(statusEl, lines);
        statusEl.className = 'text-xs mt-1 text-danger-text';
      } else {
        statusEl.textContent = filesList?.dataset.fileFailed || 'Failed to remove metadata';
        statusEl.className = 'text-xs mt-1 text-danger-text';
      }
      downloadBtn.disabled = true;
      removeBtn.disabled = false;
      removeBtn.textContent = filesList?.dataset.tryAgain || 'Try again';
      return;
    }

    if (item.verifyStatus === 'verifying') {
      // Clean output generated; the actual bytes are being re-scanned before
      // anything is claimed about them.
      statusEl.textContent = filesList?.dataset.verifyingCleanOutput || 'Verifying clean output…';
      statusEl.className = 'text-xs mt-1 text-text-muted';
      downloadBtn.disabled = true;
      removeBtn.disabled = true;
      removeBtn.textContent = filesList?.dataset.removing || 'Removing...';
      return;
    }

    if (item.busy) {
      statusEl.textContent = filesList?.dataset.removing || 'Removing...';
      statusEl.className = 'text-xs mt-1 text-text-muted';
      downloadBtn.disabled = true;
      removeBtn.disabled = true;
      removeBtn.textContent = filesList?.dataset.removing || 'Removing...';
      return;
    }

    if (item.cleanBlob) {
      // Only a verified output is reachable here: the count is whatever the
      // re-scan of the generated bytes produced (0 when verification passed).
      setStatusLines(statusEl, [
        `✓ ${filesList?.dataset.successFile || 'Metadata removed successfully'}`,
        remainingLine(item.remainingPrivacyMetadata),
      ]);
      statusEl.className = 'text-xs mt-1 text-success-text font-medium';
      downloadBtn.disabled = item.verifyStatus !== 'passed';
      removeBtn.disabled = true;
      removeBtn.textContent = '✓ Success';
      return;
    }

    const technicalCount = filterMetadata(item.metadata).filter(e => !e.privacy).length;
    const privacyCount = countPrivacyFields(item.metadata);

    if (privacyCount > 0) {
      statusEl.textContent = `${fieldsFound} (${privacyCount})`;
      statusEl.className = 'text-xs mt-1 text-text-muted';
    } else if (technicalCount > 0) {
      const preserved = filesList?.dataset.technicalPreserved || 'Technical image information preserved: {{count}} properties';
      setStatusLines(statusEl, [
        `✓ ${noMetadata}`,
        preserved.replace('{{count}}', String(technicalCount)),
      ]);
      statusEl.className = 'text-xs mt-1 text-text-muted';
    } else {
      statusEl.textContent = `✓ ${noMetadata}`;
      statusEl.className = 'text-xs mt-1 text-text-muted';
    }
    downloadBtn.disabled = true;
    removeBtn.disabled = false;
    removeBtn.textContent = removeLabel;
  }

  async function removeMetadata(id: number) {
    const item = fileItems.find((f) => f.id === id);
    if (!item) return;
    await stripMetadata(item);
  }

  async function removeAllMetadata() {
    if (busyCount > 0) return;
    const pending = fileItems.filter((f) => !f.error && f.cleanBlob === null);
    if (pending.length === 0) return;

    const thisBatchId = batchId;
    setGlobalStatus('processing');

    for (const item of pending) {
      await stripMetadata(item);
    }

    if (thisBatchId !== batchId) return;

    const total = pending.length;
    const success = pending.filter((f) => f.cleanBlob !== null && !f.error).length;
    const failed = pending.filter((f) => f.error).length;

    if (failed === 0 && success > 0) {
      setGlobalStatus('success', { success, total });
      announce(filesList?.dataset.successAll || '');
    } else if (success > 0 && failed > 0) {
      setGlobalStatus('partial-error', { success, total });
      announce(
        (filesList?.dataset.partialSuccess || '')
          .replace('{{success}}', String(success))
          .replace('{{total}}', String(total)),
      );
    } else if (failed > 0) {
      setGlobalStatus('error', { success, total });
      announce(filesList?.dataset.errorAll || '');
    } else {
      setGlobalStatus('idle');
    }

    updateProgress();

    if (removeAllBtn) {
      if (failed === 0 && success > 0) {
        removeAllBtn.textContent = '✓ Success';
      } else if (success > 0 && failed > 0) {
        removeAllBtn.textContent = `⚠ ${success}/${pending.length}`;
      } else if (failed > 0 && success === 0) {
        removeAllBtn.textContent = filesList?.dataset.failedToRemove || '✕ Failed to remove metadata';
      } else {
        removeAllBtn.textContent = filesList?.dataset.removeAll || 'Remove all metadata';
      }
    }
  }

  const STRIP_TIMEOUT_MS = 30_000;

  function withTimeout<T>(promise: Promise<T>, ms: number): Promise<T> {
    return Promise.race([
      promise,
      new Promise<T>((_, reject) => setTimeout(() => reject(new Error('Operation timed out')), ms)),
    ]);
  }

  function decodeBlobFromDataUrl(dataUrl: string): Blob {
    const [header, data] = dataUrl.split(',');
    const mime = header.match(/:(.*?);/)?.[1] || 'image/png';
    const binary = atob(data);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return new Blob([bytes], { type: mime });
  }

  function stripJpegPrivacySegments(bytes: Uint8Array): Uint8Array {
    if (bytes.length < 4 || bytes[0] !== 0xff || bytes[1] !== 0xd8) {
      throw new Error('Invalid JPEG: missing SOI');
    }

    const kept: Array<[number, number]> = [[0, 2]];

    let pos = 2;
    while (pos + 1 < bytes.length) {
      while (pos + 1 < bytes.length && bytes[pos] === 0xff && bytes[pos + 1] === 0xff) {
        pos++;
      }
      if (pos + 1 >= bytes.length) throw new Error('Invalid JPEG: truncated stream');
      if (bytes[pos] !== 0xff) throw new Error('Invalid JPEG: missing marker prefix');

      const marker = bytes[pos + 1];

      if (marker === 0xd9) {
        kept.push([pos, bytes.length]);
        return collectRanges(bytes, kept);
      }

      if (marker === 0x01 || (marker >= 0xd0 && marker <= 0xd8)) {
        kept.push([pos, pos + 2]);
        pos += 2;
        continue;
      }

      if (pos + 3 >= bytes.length) throw new Error('Invalid JPEG: truncated segment header');
      const len = (bytes[pos + 2] << 8) | bytes[pos + 3];
      const segEnd = pos + 2 + len;
      if (len < 2 || segEnd > bytes.length) throw new Error('Invalid JPEG: bad segment length');
      const payload = pos + 4;

      if (marker === 0xe1 && isJpegApp1Privacy(bytes, payload)) {
        pos = segEnd;
        continue;
      }
      if (marker === 0xed && isJpegApp13Iptc(bytes, payload)) {
        pos = segEnd;
        continue;
      }
      if (marker === 0xfe) {
        pos = segEnd;
        continue;
      }

      if (marker === 0xda) {
        const eoi = findJpegEoi(bytes, segEnd);
        kept.push([pos, segEnd], [segEnd, eoi], [eoi, bytes.length]);
        return collectRanges(bytes, kept);
      }

      kept.push([pos, segEnd]);
      pos = segEnd;
    }

    throw new Error('Invalid JPEG: missing EOI');
  }

  function collectRanges(bytes: Uint8Array, ranges: Array<[number, number]>): Uint8Array {
    let total = 0;
    for (const [s, e] of ranges) total += e - s;
    const out = new Uint8Array(total);
    let offset = 0;
    for (const [s, e] of ranges) {
      out.set(bytes.subarray(s, e), offset);
      offset += e - s;
    }
    return out;
  }

  function isJpegApp1Privacy(bytes: Uint8Array, p: number): boolean {
    if (
      p + 6 <= bytes.length &&
      bytes[p] === 0x45 && bytes[p + 1] === 0x78 && bytes[p + 2] === 0x69 &&
      bytes[p + 3] === 0x66 && bytes[p + 4] === 0x00 && bytes[p + 5] === 0x00
    ) {
      return true;
    }
    if (
      p + 7 <= bytes.length &&
      bytes[p] === 0x68 && bytes[p + 1] === 0x74 && bytes[p + 2] === 0x74 &&
      bytes[p + 3] === 0x70 && bytes[p + 4] === 0x3a && bytes[p + 5] === 0x2f && bytes[p + 6] === 0x2f
    ) {
      return true;
    }
    return false;
  }

  function isJpegApp13Iptc(bytes: Uint8Array, p: number): boolean {
    if (p + 13 > bytes.length) return false;
    return bytes[p] === 0x50 && bytes[p + 1] === 0x68 && bytes[p + 2] === 0x6f &&
      bytes[p + 3] === 0x74 && bytes[p + 4] === 0x6f && bytes[p + 5] === 0x73 &&
      bytes[p + 6] === 0x68 && bytes[p + 7] === 0x6f && bytes[p + 8] === 0x70 &&
      bytes[p + 9] === 0x20 && bytes[p + 10] === 0x33 && bytes[p + 11] === 0x2e && bytes[p + 12] === 0x30;
  }

  function findJpegEoi(bytes: Uint8Array, start: number): number {
    let i = start;
    while (i + 1 < bytes.length) {
      if (bytes[i] === 0xff) {
        const m = bytes[i + 1];
        if (m === 0x00) { i += 2; continue; }
        if (m >= 0xd0 && m <= 0xd7) { i += 2; continue; }
        if (m === 0xd9) return i;
        if (m === 0x01) { i += 2; continue; }
        if (m === 0xff) { i++; continue; }
        if (m === 0xda) {
          if (i + 3 >= bytes.length) throw new Error('Invalid JPEG: truncated scan header');
          const l = (bytes[i + 2] << 8) | bytes[i + 3];
          if (l < 2 || i + 2 + l > bytes.length) throw new Error('Invalid JPEG: bad scan header');
          i += 2 + l;
          continue;
        }
        if (i + 3 >= bytes.length) throw new Error('Invalid JPEG: truncated marker');
        const l = (bytes[i + 2] << 8) | bytes[i + 3];
        if (l < 2 || i + 2 + l > bytes.length) throw new Error('Invalid JPEG: bad marker length');
        i += 2 + l;
        continue;
      }
      i++;
    }
    throw new Error('Invalid JPEG: missing EOI');
  }

  /** Media type of the generated output, used to pick the verification parser. */
  function outputMimeType(item: FileItem): string {
    const fromBlob = (item.cleanBlob?.type || '').toLowerCase();
    if (fromBlob) return fromBlob;
    const map: Record<string, string> = {
      jpg: 'image/jpeg',
      jpeg: 'image/jpeg',
      png: 'image/png',
      webp: 'image/webp',
      tiff: 'image/tiff',
      tif: 'image/tiff',
    };
    return map[item.cleanExt.toLowerCase()] || '';
  }

  /**
   * Verify the ACTUAL generated clean output - never the removal result, never
   * the pre-removal metadata object.
   *
   *   cleanBlob -> bytes -> privacy-container scan + format parser -> classifier
   *
   * The privacy count comes from the existing classifier applied to a fresh
   * parse of those bytes. If privacy fields or an unverifiable privacy
   * container survive, or the output cannot be parsed at all, the unverified
   * blob is discarded and the item is put into the existing failure/retry
   * state, so nothing can be downloaded as "verified clean".
   */
  async function verifyCleanOutput(item: FileItem): Promise<void> {
    const blob = item.cleanBlob;
    if (!blob) {
      item.verifyStatus = 'failed';
      item.remainingPrivacyMetadata = 0;
      item.error = true;
      return;
    }

    try {
      const bytes = new Uint8Array(await withTimeout(blob.arrayBuffer(), STRIP_TIMEOUT_MS));
      const mime = outputMimeType(item);

      // 1) Byte-level container check on the generated output.
      const findings = findOutputPrivacyFindings(bytes, mime);

      // 2) Re-parse the same generated bytes with the parser that matches the
      //    output format and classify the result with the existing classifier.
      const exifr = await import('exifr');
      const parsed = await withTimeout(
        parseMetadataForFileType(bytes.buffer as ArrayBuffer, mime, exifr),
        STRIP_TIMEOUT_MS,
      );
      // Defensive: the classifier reads an object, whatever the parser returned
      // for an output that carries no metadata at all.
      const remaining = filterMetadata(parsed || {}).filter((entry) => entry.privacy);

      item.remainingPrivacyMetadata = remaining.length;

      if (remaining.length > 0) {
        console.warn(
          'Clean-output verification: privacy metadata still present in the generated output:',
          remaining.map((entry) => entry.label).join(', '),
        );
        item.verifyStatus = 'remaining';
        item.error = true;
        item.cleanBlob = null;
        return;
      }

      if (findings.length > 0) {
        console.warn(
          'Clean-output verification: privacy container still present in the generated output:',
          findings.map((f) => f.kind + ' (' + f.detail + ')').join(', '),
        );
        item.verifyStatus = 'failed';
        item.error = true;
        item.cleanBlob = null;
        return;
      }

      item.verifyStatus = 'passed';
      item.error = false;
    } catch (err) {
      console.error('Clean-output verification failed:', err);
      item.verifyStatus = 'failed';
      item.remainingPrivacyMetadata = 0;
      item.error = true;
      item.cleanBlob = null;
    }
  }

  /**
   * Shared tail of every removal branch: publish the generated output, let the
   * UI show that the output is being verified, verify the real bytes, and only
   * then publish the final per-file state (and, when verification passed, the
   * download button).
   *
   * Respects the same batch/item identity guard as the removal itself: a stale
   * operation never touches the UI of a newer upload.
   */
  async function finishWithVerification(item: FileItem, thisBatchId: number): Promise<void> {
    if (thisBatchId !== batchId) {
      // A newer upload replaced this batch - drop the stale result silently.
      item.busy = false;
      return;
    }

    item.verifyStatus = 'verifying';
    item.remainingPrivacyMetadata = 0;
    reRenderItem(item);

    await verifyCleanOutput(item);

    item.busy = false;
    if (thisBatchId !== batchId) {
      // A newer upload replaced this batch while the output was being verified.
      // Never publish this result onto the new batch's DOM.
      return;
    }

    busyCount--;
    refreshActions();
    reRenderItem(item);

    if (countPrivacyFields(item.metadata) > 0) {
      trackEvent('removal_complete');
    }
  }

  async function stripMetadata(item: FileItem): Promise<void> {
    if (item.busy || item.cleanBlob !== null || item.error) return;

    const thisBatchId = batchId;

    item.cleanBlob = null;
    item.error = false;
    item.verifyStatus = 'unverified';
    item.remainingPrivacyMetadata = 0;
    item.busy = true;
    busyCount++;
    refreshActions();

    const id = `remove-${item.id}`;
    if (id) {
      const btn = document.getElementById(id) as HTMLButtonElement | null;
      if (btn) {
        btn.textContent = filesList?.dataset.removing || 'Removing...';
        btn.disabled = true;
      }
    }

    let bitmap: ImageBitmap | null = null;
    try {
      if (item.file.type === 'image/jpeg') {
        try {
          const source = new Uint8Array(await withTimeout(item.file.arrayBuffer(), STRIP_TIMEOUT_MS));
          const stripped = stripJpegPrivacySegments(source);
          const cleanJpeg = new Blob([stripped], { type: 'image/jpeg' });
          bitmap = await withTimeout(createImageBitmap(cleanJpeg), STRIP_TIMEOUT_MS);
          if (!bitmap.width || !bitmap.height) {
            throw new Error('Decoded JPEG is invalid');
          }
          // The decode exists only to prove the stripped bytes are still a
          // decodable JPEG - its pixels are never used. A 12 MP bitmap is
          // ~47 MB, so release it immediately instead of leaving one decoded
          // image per file alive for the rest of a large batch.
          bitmap.close();
          bitmap = null;
          item.cleanBlob = cleanJpeg;
          item.cleanExt = 'jpg';
          // The generated JPEG bytes are re-scanned before success is claimed.
          await finishWithVerification(item, thisBatchId);
          return;
        } catch (_jpegErr) {
          if (bitmap) {
            bitmap.close();
            bitmap = null;
          }
        }
      }

      // TIFF: Chromium cannot decode TIFF with createImageBitmap, so the
      // generic canvas path below can never produce an output. Strip the
      // container instead (tags + thumbnail removed, pixels copied verbatim,
      // ICC kept) and keep the file a real TIFF. Errors propagate to the
      // outer handler, which resolves the busy state and shows the localized
      // failure message.
      if (isTiffFile(item.file)) {
        const source = new Uint8Array(await withTimeout(item.file.arrayBuffer(), STRIP_TIMEOUT_MS));
        const stripped = stripTiffMetadata(source);
        const cleanTiff = new Blob([stripped.bytes], { type: 'image/tiff' });
        if (cleanTiff.size === 0) {
          throw new Error('TIFF stripping produced an empty image');
        }
        item.cleanBlob = cleanTiff;
        item.cleanExt = 'tiff';
        // The generated TIFF bytes are re-scanned before success is claimed.
        await finishWithVerification(item, thisBatchId);
        return;
      }

      // WebP: unlike JPEG and TIFF, a WebP *can* be decoded by Chromium, so it
      // used to fall through to the canvas re-encode below — which can only
      // emit JPEG and therefore silently changed the user's format. Strip the
      // RIFF container instead: the EXIF/XMP chunks go, the VP8/VP8L image
      // payload, alpha, ICC profile and animation chunks are copied verbatim,
      // and the download stays a real .webp.
      if (item.file.type === 'image/webp') {
        const source = new Uint8Array(await withTimeout(item.file.arrayBuffer(), STRIP_TIMEOUT_MS));
        const stripped = stripWebpMetadata(source);
        const cleanWebp = new Blob([stripped.bytes], { type: 'image/webp' });
        if (cleanWebp.size === 0) {
          throw new Error('WebP stripping produced an empty image');
        }
        item.cleanBlob = cleanWebp;
        item.cleanExt = 'webp';
        // The generated WebP bytes are re-scanned before success is claimed.
        await finishWithVerification(item, thisBatchId);
        return;
      }

      if (isHeicFile(item.file)) {
        const avifInput = await isAvifFile(item.file);
        if (!avifInput) {
          try {
            const heic2any = (await import('heic2any')).default;
            const result = await withTimeout(
              heic2any({ blob: item.file, toType: 'image/jpeg', quality: 0.92 }),
              STRIP_TIMEOUT_MS
            );
            const cleanJpeg: Blob = Array.isArray(result) ? result[0] : result;
            if (!cleanJpeg || cleanJpeg.size === 0) {
              throw new Error('HEIC decoding produced an empty image');
            }
            await validateJpegBlob(cleanJpeg);
            item.cleanBlob = cleanJpeg;
            item.cleanExt = 'jpg';
            // The converted JPEG bytes are re-scanned before success is claimed.
            await finishWithVerification(item, thisBatchId);
            return;
          } catch (_heicErr) {
            if (bitmap) {
              bitmap.close();
              bitmap = null;
            }
          }
        }
      }

      bitmap = await withTimeout(createImageBitmap(item.file), STRIP_TIMEOUT_MS);
      const canvas = document.createElement('canvas');
      canvas.width = bitmap.width;
      canvas.height = bitmap.height;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Could not get canvas context');
      ctx.drawImage(bitmap, 0, 0);
      bitmap.close();
      bitmap = null;

      const mimeType = item.file.type === 'image/png' ? 'image/png' : 'image/jpeg';
      const quality = mimeType === 'image/jpeg' ? 0.92 : undefined;
      const blob = await new Promise<Blob>((resolve, reject) => {
        canvas.toBlob(
          (b) => (b ? resolve(b) : reject(new Error('Canvas toBlob failed'))),
          mimeType,
          quality,
        );
      });

      item.cleanBlob = blob;
      item.cleanExt = mimeType === 'image/png' ? 'png' : 'jpg';
      // The re-encoded output bytes are re-scanned before success is claimed.
      await finishWithVerification(item, thisBatchId);
      return;
    } catch (err) {
      console.error('Error stripping metadata:', err);
      if (bitmap) {
        // A failure must not leave a decoded bitmap behind either.
        bitmap.close();
        bitmap = null;
      }
      item.error = true;
      item.busy = false;
      // No verified output exists: drop anything that was published mid-way so
      // an unverified blob can never reach the download / ZIP path.
      item.cleanBlob = null;
      item.verifyStatus = 'unverified';
      item.remainingPrivacyMetadata = 0;
      if (thisBatchId === batchId) {
        busyCount--;
        refreshActions();
      }
      reRenderItem(item);
      return;
    }
  }

  function reRenderItem(item: FileItem) {
    const el = filesList?.querySelector(`[data-id="${item.id}"]`);
    if (!el) return;
    const statusEl = el.querySelector('.text-xs.mt-1') as HTMLElement;
    const downloadBtn = el.querySelector(`#download-${item.id}`) as HTMLButtonElement;
    const removeBtn = el.querySelector(`#remove-${item.id}`) as HTMLButtonElement;
    if (statusEl && downloadBtn && removeBtn) {
      updateItemStatus(item, statusEl, downloadBtn, removeBtn);
    }
    refreshActions();
  }

  function refreshActions() {
    const allClean = fileItems.length > 0 && fileItems.every((f) => f.cleanBlob !== null || f.error);
    const hasClean = fileItems.some((f) => f.cleanBlob !== null);
    const hasPending = fileItems.some((f) => !f.error && f.cleanBlob === null);

    if (removeAllBtn) {
      removeAllBtn.classList.toggle('hidden', !hasPending || busyCount > 0);
      removeAllBtn.onclick = () => removeAllMetadata();
    }

    if (downloadAllBtn) {
      downloadAllBtn.classList.toggle('hidden', !hasClean);
      downloadAllBtn.onclick = () => downloadAllItems();
    }

    if (showMetadataBtn) {
      showMetadataBtn.classList.toggle('hidden', fileItems.length === 0);
    }
  }

  function downloadItem(id: number) {
    const item = fileItems.find((f) => f.id === id);
    if (!item || !item.cleanBlob) return;
    const url = URL.createObjectURL(item.cleanBlob);
    const a = document.createElement('a');
    a.href = url;
    const baseName = item.file.name.replace(/\.[^.]+$/, '');
    a.download = `${baseName}-clean.${item.cleanExt}`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    trackEvent('download_complete');
  }

  async function downloadAllItems() {
    if (zipBusy) return;
    const cleanItems = fileItems.filter((f) => f.cleanBlob !== null);
    if (cleanItems.length === 0) return;

    if (cleanItems.length === 1) {
      downloadItem(cleanItems[0].id);
      return;
    }

    zipBusy = true;
    refreshActions();

    try {
      const JSZip = (await import('jszip')).default;
      const zip = new JSZip();
      for (const item of cleanItems) {
        const baseName = item.file.name.replace(/\.[^.]+$/, '');
        zip.file(`${baseName}-clean.${item.cleanExt}`, item.cleanBlob!);
      }
      const blob = await zip.generateAsync({ type: 'blob' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'clean-images.zip';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      trackEvent('download_complete', { format: 'zip', count: cleanItems.length });
    } catch (err) {
      console.error('Error creating ZIP:', err);
    } finally {
      zipBusy = false;
      refreshActions();
    }
  }

  function resetTool() {
    // Invalidate any in-flight removal/verification so a reset batch can never
    // be mutated (or have its busy counter decremented) by stale async work.
    batchId++;
    revokeAllPreviews();
    if (filesList) filesList.innerHTML = '';
    fileItems = [];
    nextId = 1;
    busyCount = 0;
    processingStatus?.classList.add('hidden');
    resultsPanel?.classList.add('hidden');
    uploadErrorEl?.classList.add('hidden');
    setGlobalStatus('idle');
    resetZipState();
    closeMetadataViewer();
    updateProgress();
    if (removeAllBtn) removeAllBtn.textContent = filesList?.dataset.removeAll || 'Remove all metadata';
  }

  resetBtn?.addEventListener('click', resetTool);

  function setGlobalStatus(status: typeof globalStatus, data?: { success: number; total: number }) {
    globalStatus = status;
    if (!globalStatusEl) return;
    globalStatusEl.classList.add('hidden');
    globalStatusEl.innerHTML = '';

    if (status === 'idle') return;

    const banner = document.createElement('div');
    banner.className = 'px-4 sm:px-5 py-3 text-[13px] font-medium tracking-tight';

    if (status === 'processing') {
      banner.className += ' text-text-muted';
      banner.textContent = 'Processing...';
    } else if (status === 'success') {
      banner.className += ' bg-success-bg text-success-text border-b border-success-border';
      banner.textContent = `✓ ${data?.success || 0} files cleaned`;
    } else if (status === 'partial-error') {
      banner.className += ' bg-warning-bg text-warning-text border-b border-warning-border';
      banner.textContent = `⚠ ${data?.success || 0}/${data?.total || 0} files cleaned`;
    } else if (status === 'error') {
      banner.className += ' bg-danger-bg text-danger-text border-b border-danger-border';
      banner.textContent = '✕ Failed to clean files';
    }

    globalStatusEl.appendChild(banner);
    globalStatusEl.classList.remove('hidden');
  }

  function resetZipState() {
    zipBusy = false;
  }

  function closeMetadataViewer() {
    metadataViewerOpen = false;
    metadataViewerPanel?.classList.add('hidden');
    if (showMetadataBtn) {
      showMetadataBtn.setAttribute('aria-expanded', 'false');
      showMetadataBtn.textContent = filesList?.dataset.showMetadata || 'Show metadata';
    }
  }

  function toggleMetadataViewer() {
    metadataViewerOpen = !metadataViewerOpen;
    metadataViewerPanel?.classList.toggle('hidden', !metadataViewerOpen);
    if (showMetadataBtn) {
      showMetadataBtn.setAttribute('aria-expanded', String(metadataViewerOpen));
      showMetadataBtn.textContent = metadataViewerOpen
        ? (filesList?.dataset.hide_metadata || 'Hide metadata')
        : (filesList?.dataset.show_metadata || 'Show metadata');
    }
  }

  showMetadataBtn?.addEventListener('click', toggleMetadataViewer);
  closeMetadataBtn?.addEventListener('click', closeMetadataViewer);

  function toggleFileMetadata(id: number) {
    const item = fileItems.find((f) => f.id === id);
    if (!item) return;

    const panel = document.getElementById(`metadata-panel-${id}`);
    if (panel) {
      panel.remove();
      const btn = document.getElementById(`meta-toggle-${id}`);
      if (btn) btn.setAttribute('aria-expanded', 'false');
      return;
    }

    const el = filesList?.querySelector(`[data-id="${id}"]`);
    if (!el) return;

    const newPanel = document.createElement('div');
    newPanel.id = `metadata-panel-${id}`;
    newPanel.className = 'p-4 sm:p-5 border-t border-border bg-surface-muted/50 pmr-fade-in';

    const metadata = item.metadata;
    const filtered = filterMetadata(metadata);

    if (filtered.length === 0) {
      newPanel.innerHTML = `<p class="text-[13px] text-text-muted">${filesList?.dataset.noMetadataFound || 'No metadata found'}</p>`;
    } else {
      const table = document.createElement('div');
      table.className = 'space-y-2';
      for (const entry of filtered) {
        const row = document.createElement('div');
        row.className = 'flex items-start justify-between gap-3 text-[12.5px]';
        const label = document.createElement('span');
        label.className = 'text-text-muted font-medium';
        label.textContent = entry.label;
        const value = document.createElement('span');
        value.className = 'text-text text-right';
        value.textContent = entry.value;
        if (entry.privacy) {
          row.className += ' bg-warning-bg/50 -mx-2 px-2 py-1 rounded';
        }
        row.appendChild(label);
        row.appendChild(value);
        table.appendChild(row);
      }
      newPanel.appendChild(table);
    }

    el.after(newPanel);
    const btn = document.getElementById(`meta-toggle-${id}`);
    if (btn) btn.setAttribute('aria-expanded', 'true');
  }

  function filterMetadata(metadata: Record<string, unknown>): Array<{ label: string; value: string; privacy: boolean }> {
    const result: Array<{ label: string; value: string; privacy: boolean }> = [];
    const privacyKeys = ['GPSLatitude', 'GPSLongitude', 'GPSAltitude', 'GPSDateStamp',
      'GPSTimeStamp', 'GPSLatitudeRef', 'GPSLongitudeRef', 'GPSAltitudeRef',
      'UserComment', 'ImageDescription', 'XPAuthor', 'XPTitle', 'XPComment',
      'XPKeywords', 'Artist', 'Copyright', 'Make', 'Model', 'Software',
      'DateTimeOriginal', 'DateTimeDigitized', 'DateTime'];

    for (const [key, val] of Object.entries(metadata)) {
      if (val === undefined || val === null) continue;
      const str = typeof val === 'object' ? JSON.stringify(val) : String(val);
      const isPrivacy = privacyKeys.includes(key);
      result.push({ label: key, value: str.length > 100 ? str.substring(0, 100) + '...' : str, privacy: isPrivacy });
    }
    return result;
  }

  function countPrivacyFields(metadata: Record<string, unknown>): number {
    return filterMetadata(metadata).filter(e => e.privacy).length;
  }

  function formatFileSize(bytes: number): string {
    if (bytes === 0) return '0 B';
    const units = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(1024));
    return `${(bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0)} ${units[i]}`;
  }

  function extFromType(type: string): string {
    const map: Record<string, string> = {
      'image/jpeg': 'jpg',
      'image/png': 'png',
      'image/webp': 'webp',
      'image/tiff': 'tiff',
    };
    return map[type] || 'jpg';
  }

  /**
   * exifr returns a few EXIF values (ComponentsConfiguration, UserComment, an
   * IFD1 thumbnail, ...) as typed-array VIEWS INTO the ArrayBuffer that was
   * parsed. Keeping such a view in `item.metadata` keeps that whole buffer alive
   * for as long as the item lives, so every scanned photo pinned its complete
   * source file in memory. A large batch therefore grew by (batch size x file
   * size) before any removal had even started and the tab thrashed/hung.
   *
   * Copying those values into standalone buffers keeps the parsed - and shown -
   * values byte-for-byte identical while letting the scanned bytes be collected.
   */
  function detachParsedMetadataViews<T>(parsed: T, inputBuffer: ArrayBufferLike): T {
    if (!parsed || typeof parsed !== 'object' || ArrayBuffer.isView(parsed)) return parsed;
    const record = parsed as Record<string, unknown>;
    for (const key of Object.keys(record)) {
      const value = record[key];
      if (ArrayBuffer.isView(value)) {
        if (value.buffer === inputBuffer) {
          const copy = new Uint8Array(value.byteLength);
          copy.set(new Uint8Array(value.buffer, value.byteOffset, value.byteLength));
          record[key] = copy;
        }
      } else if (value && typeof value === 'object') {
        detachParsedMetadataViews(value, inputBuffer);
      }
    }
    return parsed;
  }

  async function parseMetadataForFileType(arrayBuffer: ArrayBuffer, fileType: string, exifr: typeof import('exifr')) {
    if (fileType === 'image/webp') {
      return parseWebpMetadata(arrayBuffer, exifr);
    }
    // exifr resolves to `undefined` for a file without metadata, and the guard
    // below has to see the resolved value - not the (always truthy) Promise.
    // Without the await the fallback never applied and `metadata` could end up
    // undefined, which the verification (and the classifier) cannot read.
    const parsed = (await exifr.parse(arrayBuffer, true)) || {};
    // The scan input must never be retained through the parsed values.
    return detachParsedMetadataViews(parsed, arrayBuffer);
  }

  async function parseWebpMetadata(arrayBuffer: ArrayBuffer, exifr: typeof import('exifr')): Promise<Record<string, unknown>> {
    const result: Record<string, unknown> = {};
    if (arrayBuffer.byteLength < 12) return result;
    const view = new DataView(arrayBuffer);
    if (view.getUint32(0) !== 0x52494646) return result; // 'RIFF'
    if (view.getUint32(8) !== 0x57454250) return result; // 'WEBP'
    const fileLength = Math.min(view.getUint32(4, true) + 8, arrayBuffer.byteLength);
    let offset = 12;
    while (offset + 8 <= fileLength) {
      const chunkId = String.fromCharCode(view.getUint8(offset), view.getUint8(offset + 1), view.getUint8(offset + 2), view.getUint8(offset + 3));
      const chunkSize = view.getUint32(offset + 4, true);
      if (offset + 8 + chunkSize > arrayBuffer.byteLength) break;
      if (chunkId === 'EXIF') {
        const exifData = new Uint8Array(arrayBuffer, offset + 8, chunkSize);
        // The chunk payload is a bare TIFF/EXIF block that most writers
        // introduce with the 6-byte "Exif\0\0" identifier. Normalize before
        // parsing, otherwise the TIFF parser rejects the payload, the UI
        // reports "no metadata", and the file takes the wrong removal path.
        const parsed = await parseExifFromBytes(normalizeWebpExifPayload(exifData), exifr);
        Object.assign(result, parsed);
        if (Object.keys(result).length > 0) return result;
      }
      offset += 8 + chunkSize;
      if (chunkSize % 2 !== 0) offset++;
    }
    return result;
  }

  async function parseExifFromBytes(bytes: Uint8Array, exifr: typeof import('exifr')): Promise<Record<string, unknown>> {
    const result: Record<string, unknown> = {};
    if (bytes.length < 8) return result;

    // The payload arriving here is always a bare TIFF/EXIF block: the WebP
    // reader has already skipped the optional "Exif\0\0" identifier. Use exifr
    // to parse it since it handles TIFF/EXIF correctly (both byte orders).
    try {
      const payload = bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.length);
      const parsed = await exifr.parse(payload, true);
      if (parsed && typeof parsed === 'object') {
        // Same reason as in parseMetadataForFileType: no parsed value may keep
        // the parsed buffer (here a slice of the WebP chunk) alive.
        Object.assign(result, detachParsedMetadataViews(parsed, payload));
      }
    } catch {
      // exifr failed — fall through to empty result
    }
    return result;
  }
</script>
