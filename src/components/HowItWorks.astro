---
import { getTranslations, t } from '../i18n/index';

const { lang = 'en' } = Astro.props;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);

const steps = [
  {
    num: '01',
    titleKey: 'how_it_works.step1.title',
    descKey: 'how_it_works.step1.description',
    icon: 'upload',
  },
  {
    num: '02',
    titleKey: 'how_it_works.step2.title',
    descKey: 'how_it_works.step2.description',
    icon: 'scan',
  },
  {
    num: '03',
    titleKey: 'how_it_works.step3.title',
    descKey: 'how_it_works.step3.description',
    icon: 'remove',
  },
  {
    num: '04',
    titleKey: 'how_it_works.step4.title',
    descKey: 'how_it_works.step4.description',
    icon: 'download',
  },
] as const;
---

<section id="how-it-works" class="py-16 sm:py-20 px-4 sm:px-6 border-t border-border scroll-mt-16">
  <div class="max-w-5xl mx-auto">
    <!-- Section header -->
    <div class="max-w-2xl mb-10 sm:mb-14">
      <span class="pmr-eyebrow">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent"></span>
        {t(translations, 'how_it_works.eyebrow')}
      </span>
      <h2 class="mt-3 text-[28px] sm:text-[36px] font-semibold tracking-tight text-text leading-[1.1]">
        {t(translations, 'how_it_works.title')}
      </h2>
      <p class="mt-4 text-[15.5px] text-text-muted leading-relaxed">
        {t(translations, 'how_it_works.subtitle')}
      </p>
    </div>

    <!-- Step grid -->
    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      {steps.map((step, i) => (
        <li class="pmr-card p-5 sm:p-6 relative group">
          <!-- Connector line (desktop only) -->
          {i < steps.length - 1 && (
            <span
              class="hidden lg:block absolute top-12 -right-2 w-4 h-px bg-border"
              aria-hidden="true"
            ></span>
          )}

          <div class="flex items-center justify-between mb-4">
            <span class="font-mono text-[12px] tracking-wider text-text-faint">
              {step.num}
            </span>
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-accent-soft text-accent" aria-hidden="true">
              {step.icon === 'upload' && (
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 7.5m0 0L7.5 12M12 7.5v9" />
                </svg>
              )}
              {step.icon === 'scan' && (
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              )}
              {step.icon === 'remove' && (
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2" />
                </svg>
              )}
              {step.icon === 'download' && (
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
              )}
            </span>
          </div>

          <h3 class="text-[16px] font-semibold tracking-tight text-text leading-snug">
            {t(translations, step.titleKey)}
          </h3>
          <p class="mt-1.5 text-[13.5px] text-text-muted leading-relaxed">
            {t(translations, step.descKey)}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
