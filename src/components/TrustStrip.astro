---
import { getTranslations, t } from '../i18n/index';

const { lang = 'en' } = Astro.props;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 border-t border-slate-200/70" data-purpose="trust-badges">
  <!-- Section header -->
  <div class="text-center mb-8">
    <span class="pmr-eyebrow justify-center">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent"></span>
      {t(translations, 'trust.eyebrow')}
    </span>
    <h2 class="mt-3 text-[24px] sm:text-[30px] font-bold tracking-tight text-slate-900 leading-[1.1]">
      {t(translations, 'trust.title')}
    </h2>
    <p class="mt-4 text-[14px] text-slate-500 leading-relaxed max-w-xl mx-auto">
      {t(translations, 'trust.subtitle')}
    </p>
  </div>

  <!-- Trust badges (Stitch) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-full bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-700 shrink-0" aria-hidden="true">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
        </svg>
      </div>
      <div>
        <h4 class="text-sm font-bold text-slate-900">{t(translations, 'trust.items.client_side.title')}</h4>
        <p class="text-xs text-slate-500">{t(translations, 'trust.items.client_side.description')}</p>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-full bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-700 shrink-0" aria-hidden="true">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect height="11" rx="2" ry="2" width="18" x="3" y="11" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
      </div>
      <div>
        <h4 class="text-sm font-bold text-slate-900">{t(translations, 'trust.items.open_source.title')}</h4>
        <p class="text-xs text-slate-500">{t(translations, 'trust.items.open_source.description')}</p>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-full bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-700 shrink-0" aria-hidden="true">
        <svg class="w-6 h-6 fill-brand-700" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
      </div>
      <div>
        <h4 class="text-sm font-bold text-slate-900">{t(translations, 'trust.items.built_for.title')}</h4>
        <p class="text-xs text-slate-500">{t(translations, 'trust.items.built_for.description')}</p>
      </div>
    </div>
  </div>

  <!-- CTAs (existing anchors) -->
  <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
    <a
      href="#how-it-works"
      class="inline-flex items-center justify-center gap-1.5 min-h-[44px] px-6 rounded-full bg-brand-800 text-white text-[13.5px] font-medium hover:bg-brand-900 transition-colors"
    >
      {t(translations, 'trust.cta')}
    </a>
    <a
      href="#faq"
      class="inline-flex items-center justify-center gap-1.5 min-h-[44px] px-6 rounded-full border border-slate-300 bg-white text-text text-[13.5px] font-medium hover:bg-surface-muted transition-colors"
    >
      {t(translations, 'trust.secondary_cta')}
    </a>
  </div>
</section>
