---
import { getTranslations, t } from '../i18n/index';

const { lang = 'en' } = Astro.props;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);

const cards = [
  { key: 'how', icon: 'how', href: '#how-it-works' },
  { key: 'audit', icon: 'audit', href: '#privacy-risk' },
  { key: 'fidelity', icon: 'fidelity', href: '#fidelity' },
  { key: 'tech', icon: 'tech', href: '/' + currentLang + '/guides/what-is-exif' },
] as const;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" data-purpose="feature-grid">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {cards.map((card) => (
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200/80 flex flex-col justify-between hover:shadow-md transition-shadow">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-9 h-9 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-700" aria-hidden="true">
              {card.icon === 'how' && (
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <polygon points="12 2 2 7 12 12 22 7 12 2" />
                  <polyline points="2 17 12 22 22 17" />
                  <polyline points="2 12 12 17 22 12" />
                </svg>
              )}
              {card.icon === 'audit' && (
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              )}
              {card.icon === 'fidelity' && (
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect height="16" rx="2" ry="2" width="16" x="4" y="4" />
                  <circle cx="9.5" cy="9.5" r="1.5" />
                  <polyline points="21 15 16 10 5 21" />
                </svg>
              )}
              {card.icon === 'tech' && (
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <polyline points="16 18 22 12 16 6" />
                  <polyline points="8 6 2 12 8 18" />
                </svg>
              )}
            </div>
            <h4 class="text-sm font-bold text-slate-900 tracking-tight">{t(translations, 'features.cards.' + card.key + '.title')}</h4>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">
            {t(translations, 'features.cards.' + card.key + '.description')}
          </p>
        </div>
        <a class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-700 hover:text-brand-800 transition-colors" href={card.href}>
          <span>{t(translations, 'features.cards.' + card.key + '.link')}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    ))}
  </div>
</section>
