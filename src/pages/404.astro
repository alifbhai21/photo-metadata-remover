---
import Layout from '../layouts/Layout.astro';
import { getTranslations, t } from '../i18n/index';

export const prerender = true;

const translations = getTranslations('en');
---

<Layout
  lang="en"
  title={t(translations, 'notfound.title')}
  description={t(translations, 'notfound.description')}
  noindex={true}
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-24 flex flex-col items-center text-center">
    <div
      class="mb-8 w-20 h-20 rounded-[20px] bg-[#EEEEEE] flex items-center justify-center shadow-sm"
      aria-hidden="true"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="rgb(244, 244, 244)" fill-opacity="0" stroke="#9F3333" stroke-width="1.23" stroke-linecap="round" stroke-linejoin="round">
        <line x1="2" x2="22" y1="2" y2="22" />
        <path d="M7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16" />
        <path d="M9.5 4h5L17 7h3a2 2 0 0 1 2 2v7.5" />
        <path d="M14.121 15.121A3 3 0 1 1 9.88 10.88" />
      </svg>
    </div>

    <p class="font-mono text-[13px] font-medium uppercase tracking-[0.2em] text-on-surface-variant" data-nf="eyebrow">
      {t(translations, 'notfound.eyebrow')}
    </p>

    <h1 class="mt-4 text-4xl sm:text-5xl font-bold tracking-tight text-on-surface" data-nf="heading">
      {t(translations, 'notfound.heading')}
    </h1>

    <p class="mt-4 text-[16px] sm:text-[17px] text-on-surface-variant leading-relaxed max-w-xl" data-nf="body">
      {t(translations, 'notfound.body')}
    </p>

    <div class="mt-10 w-full sm:w-auto flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3">
      <a
        href="/en/"
        data-nf="back"
        class="inline-flex items-center justify-center min-h-[48px] px-6 rounded-full bg-primary text-on-primary text-[15px] font-medium hover:bg-primary-container transition-colors"
      >
        {t(translations, 'notfound.back_home')}
      </a>
      <a
        href="/en/"
        data-nf="tool"
        class="inline-flex items-center justify-center min-h-[48px] px-6 rounded-full border border-outline-variant/50 bg-surface-container-lowest text-on-surface text-[15px] font-medium hover:bg-surface-container-low transition-colors"
      >
        {t(translations, 'notfound.open_tool')}
      </a>
    </div>
  </section>

  <script>
    import { getTranslations, t } from '../i18n/index';
    import { getSavedLang, detectBrowserLang } from '../lib/lang';

    const SUPPORTED = ['en', 'de', 'fr'] as const;
    type Supported = (typeof SUPPORTED)[number];

    const segment = window.location.pathname.split('/')[1] || '';
    const fromPath = (SUPPORTED as readonly string[]).includes(segment) ? (segment as Supported) : null;
    const lang: Supported = fromPath ?? getSavedLang() ?? detectBrowserLang() ?? 'en';

    const tr = getTranslations(lang);

    document.documentElement.lang = lang;
    document.title = `${t(tr, 'notfound.title')} | ${t(tr, 'site.name')}`;

    const eyebrow = document.querySelector('[data-nf="eyebrow"]');
    const heading = document.querySelector('[data-nf="heading"]');
    const body = document.querySelector('[data-nf="body"]');
    const back = document.querySelector('[data-nf="back"]');
    const tool = document.querySelector('[data-nf="tool"]');

    if (eyebrow) eyebrow.textContent = t(tr, 'notfound.eyebrow');
    if (heading) heading.textContent = t(tr, 'notfound.heading');
    if (body) body.textContent = t(tr, 'notfound.body');
    if (back) {
      back.textContent = t(tr, 'notfound.back_home');
      back.setAttribute('href', `/${lang}/`);
    }
    if (tool) {
      tool.textContent = t(tr, 'notfound.open_tool');
      tool.setAttribute('href', `/${lang}/`);
    }
  </script>
</Layout>
