---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ToolUpload from '../../components/ToolUpload.astro';
import { getTranslations, t } from '../../i18n/index';

export function getStaticPaths() {
  const langs = ['en', 'de', 'fr'] as const;
  const TOOLS = [
    'photo-metadata-remover',
    'remove-exif-data',
    'remove-gps-data',
    'view-photo-metadata',
    'remove-metadata-heic',
  ];
  const paths = [];
  for (const lang of langs) {
    for (const tool of TOOLS) {
      paths.push({ params: { lang, tool } });
    }
  }
  return paths;
}

const { lang, tool } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';

const toolSlug = tool;
if (!toolSlug) {
  throw new Error(`Unknown tool: ${tool}`);
}

const translations = getTranslations(currentLang);

const SITE_URL = (Astro.site?.origin ?? 'https://photometadataremover.com').replace(/\/$/, '');
const pageUrl = `${SITE_URL}/${currentLang}/${toolSlug}/`;

const features = [1, 2, 3].map((n) => ({
  title: t(translations, `tools.${toolSlug}.features.${n}.title`),
  text: t(translations, `tools.${toolSlug}.features.${n}.text`),
}));

const steps = [1, 2, 3].map((n) => t(translations, `tools.${toolSlug}.how_steps.${n}.text`));

const faq = [1, 2, 3].map((n) => ({
  question: t(translations, `tools.${toolSlug}.faq.${n}.question`),
  answer: t(translations, `tools.${toolSlug}.faq.${n}.answer`),
}));

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(translations, 'site.name'),
      item: `${SITE_URL}/${currentLang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(translations, `tools.${toolSlug}.title`),
      item: pageUrl,
    },
  ],
};

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: t(translations, `tools.${toolSlug}.title`),
  description: t(translations, `seo.tools.${toolSlug}.description`),
  url: pageUrl,
  inLanguage: currentLang,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any',
  featureList: features.map((f) => f.text),
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  lang={currentLang}
  title={t(translations, `seo.tools.${toolSlug}.title`)}
  description={t(translations, `seo.tools.${toolSlug}.description`)}
  jsonLd={[breadcrumbJsonLd, softwareJsonLd, faqJsonLd]}
>
  <section class="py-12 sm:py-16 px-4 sm:px-6">
    <div class="max-w-3xl mx-auto">
      <PageHeader
        lang={currentLang}
        eyebrow={t(translations, 'tool_page.eyebrow')}
        title={t(translations, `tools.${toolSlug}.title`)}
        subtitle={t(translations, `tools.${toolSlug}.subtitle`)}
      />
    </div>
  </section>

  {toolSlug === 'remove-metadata-heic' && (
    <section class="px-4 sm:px-6 pb-6">
      <div class="max-w-3xl mx-auto">
        <div class="bg-warning-bg border border-warning-border rounded-xl px-4 py-3 text-[13.5px] text-warning-text">
          {t(translations, 'tools.remove-metadata-heic.note')}
        </div>
      </div>
    </section>
  )}

  <ToolUpload lang={currentLang} />

  <section class="py-12 sm:py-16 px-4 sm:px-6">
    <div class="max-w-3xl mx-auto">
      <div class="pmr-card p-5 sm:p-6">
        <p class="text-[15.5px] text-text leading-relaxed">
          {t(translations, `tools.${toolSlug}.intro`)}
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 px-4 sm:px-6 border-t border-border">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8">
        <span class="pmr-eyebrow">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent"></span>
          {t(translations, `tools.${toolSlug}.features_title`)}
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
        {features.map((feature, i) => (
          <article class="pmr-card p-5 sm:p-6 pmr-elev-1">
            <div class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-accent-soft text-accent text-[12px] font-mono font-medium mb-3">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="text-[15px] font-semibold text-text tracking-tight leading-snug">
              {feature.title}
            </h3>
            <p class="mt-2 text-[13.5px] text-text-muted leading-relaxed">
              {feature.text}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 px-4 sm:px-6 border-t border-border">
    <div class="max-w-3xl mx-auto">
      <div class="mb-8">
        <span class="pmr-eyebrow">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent"></span>
          {t(translations, `tools.${toolSlug}.how_title`)}
        </span>
      </div>
      <ol class="space-y-3">
        {steps.map((step, i) => (
          <li class="pmr-card p-5 sm:p-6 flex gap-4 items-start">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent text-white text-[12px] font-mono font-medium shrink-0">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="text-[14.5px] text-text leading-relaxed pt-0.5">
              {step}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-12 sm:py-16 px-4 sm:px-6 border-t border-border">
    <div class="max-w-3xl mx-auto">
      <div class="mb-8">
        <span class="pmr-eyebrow">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent"></span>
          {t(translations, `tools.${toolSlug}.faq_title`)}
        </span>
      </div>
      <div class="space-y-2.5">
        {faq.map((item) => (
          <details class="group pmr-card overflow-hidden">
            <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <span class="text-[14.5px] font-medium text-text leading-snug pr-2">
                {item.question}
              </span>
              <span
                class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-border bg-surface-muted text-text-muted transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-4 text-[14px] text-text-muted leading-relaxed">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
