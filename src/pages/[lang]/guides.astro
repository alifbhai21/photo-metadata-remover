---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getTranslations, t } from '../../i18n/index';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);

const guides = [
  { slug: 'what-is-exif', key: 'what_is_exif' },
  { slug: 'gps-privacy', key: 'gps_privacy' },
  { slug: 'social-media', key: 'social_media' },
] as const;
---

<Layout lang={currentLang} title={t(translations, 'guides.title')} description={t(translations, 'seo.guides.description')}>
  <section class="py-12 sm:py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <PageHeader
        lang={currentLang}
        eyebrow={t(translations, 'guides.eyebrow')}
        title={t(translations, 'guides.title')}
        subtitle={t(translations, 'guides.subtitle')}
      />

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        {guides.map((g) => (
          <a href={`/${currentLang}/guides/${g.slug}`} class="pmr-card p-5 sm:p-6 pmr-card-hover block">
            <h2 class="text-[16px] font-semibold text-text tracking-tight leading-snug">
              {t(translations, `guides.cards.${g.key}.title`)}
            </h2>
            <p class="mt-2 text-[13.5px] text-text-muted leading-relaxed">
              {t(translations, `guides.cards.${g.key}.text`)}
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-[12.5px] font-medium text-accent">
              {t(translations, 'guides.read_more')}
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
