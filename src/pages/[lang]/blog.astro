---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { getTranslations, t } from '../../i18n/index';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);

const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === currentLang)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

const SITE_URL = (Astro.site?.origin ?? 'https://photometadataremover.com').replace(/\/$/, '');
const pageUrl = `${SITE_URL}/${currentLang}/blog/`;

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: t(translations, 'blog.title'),
  description: t(translations, 'seo.blog.description'),
  url: pageUrl,
  inLanguage: currentLang,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    datePublished: p.data.published.toISOString(),
    url: `${SITE_URL}/${currentLang}/blog/${p.data.slug}/`,
  })),
};
---

<Layout
  lang={currentLang}
  title={t(translations, 'seo.blog.title')}
  description={t(translations, 'seo.blog.description')}
  jsonLd={blogJsonLd}
>
  <section class="py-12 sm:py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <PageHeader
        lang={currentLang}
        eyebrow={t(translations, 'blog.eyebrow')}
        title={t(translations, 'blog.title')}
        subtitle={t(translations, 'blog.subtitle')}
      />

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        {posts.map((post) => (
          <a
            href={`/${currentLang}/blog/${post.data.slug}`}
            class="pmr-card p-5 sm:p-6 pmr-card-hover block"
          >
            <time
              class="text-[11px] font-mono uppercase tracking-wider text-text-faint"
              datetime={post.data.published.toISOString()}
            >
              {
                new Intl.DateTimeFormat(currentLang, {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                }).format(post.data.published)
              }
            </time>
            <h2 class="text-[16px] font-semibold text-text tracking-tight mt-2 leading-snug">
              {post.data.title}
            </h2>
            <p class="mt-2 text-[13.5px] text-text-muted leading-relaxed">
              {post.data.description}
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-[12.5px] font-medium text-accent">
              {t(translations, 'blog.read_more')}
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
