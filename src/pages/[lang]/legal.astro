---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Info/Icon.astro';
import Breadcrumbs from '../../components/Info/Breadcrumbs.astro';
import { getTranslations, t } from '../../i18n/index';
import { getLegalIdentity, isLegalConfigured } from '../../lib/legal';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);

const identity = getLegalIdentity();
const legalConfigured = isLegalConfigured();

const hubCards = [
  { key: 'terms', href: 'terms', icon: 'lock' },
  { key: 'privacy', href: 'privacy', icon: 'verified' },
  { key: 'impressum', href: 'impressum', icon: 'home' },
  { key: 'licenses', href: 'open-source', icon: 'github' },
] as const;
---

<Layout lang={currentLang} title={t(translations, 'legal_page.title')} description={t(translations, 'seo.legal.description')}>
  <div class="bg-background text-on-surface">
    <section class="overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-12">
        <Breadcrumbs current={t(translations, 'nav.legal')} />
        <div class="mt-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div class="max-w-3xl">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded bg-secondary-fixed/40 text-on-secondary-fixed text-[11px] font-mono uppercase tracking-widest font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-secondary" aria-hidden="true"></span>
              {t(translations, 'legal_page.hero_badge')}
            </span>
            <h1 class="text-[30px] sm:text-[38px] lg:text-[44px] font-semibold tracking-tight text-on-surface leading-[1.05] mt-3">{t(translations, 'legal_page.title')}</h1>
            <p class="mt-3 text-[15px] sm:text-base text-on-surface-variant">{t(translations, 'legal_page.subtitle')}</p>
          </div>
          <div class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-container-low shadow-sm">
            <Icon name="verified" class="w-5 h-5 text-secondary" />
            <div class="flex flex-col">
              <span class="text-[12px] font-mono font-semibold text-on-surface">{legalConfigured ? identity.name : t(translations, 'nav.legal')}</span>
              <span class="text-[10px] font-mono text-on-surface-variant">{legalConfigured ? t(translations, 'impressum.responsible') : t(translations, 'footer.legal_label')}</span>
            </div>
          </div>
        </div>
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
          {hubCards.map((card) => (
            <a href={`/${currentLang}/${card.href}`} class="group bg-surface-container-lowest rounded-xl p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <div class="w-10 h-10 rounded-lg bg-surface-container text-on-surface flex items-center justify-center"><Icon name={card.icon} class="w-5 h-5" /></div>
                  <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-surface-container-high text-on-surface-variant font-semibold">{t(translations, `legal_page.cards.${card.key}.badge`)}</span>
                </div>
                <h2 class="text-[18px] font-semibold text-on-surface">{t(translations, `legal_page.cards.${card.key}.title`)}</h2>
                <span class="block text-[13px] text-secondary font-medium mt-1">{t(translations, `legal_page.cards.${card.key}.sub`)}</span>
                <p class="mt-3 text-[13.5px] text-on-surface-variant leading-relaxed">{t(translations, `legal_page.cards.${card.key}.text`)}</p>
              </div>
              <span class="mt-4 inline-flex items-center gap-2 text-[13px] font-semibold text-on-surface group-hover:text-secondary transition-colors">
                {t(translations, `legal_page.cards.${card.key}.link`)}
                <Icon name="chevron" class="w-4 h-4" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
    <section class="pt-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-primary text-on-primary rounded-xl p-8 md:p-10 shadow-lg relative overflow-hidden">
          <div class="absolute right-0 top-0 bottom-0 w-1/3 opacity-10 pointer-events-none hidden lg:flex items-center justify-center" aria-hidden="true">
            <Icon name="lock" class="w-40 h-40" />
          </div>
          <div class="relative max-w-3xl">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded bg-surface-container-lowest/10 text-secondary-fixed text-[10px] font-mono uppercase tracking-wider font-semibold">
              <Icon name="lock" class="w-4 h-4" />
              {t(translations, 'legal_page.warranty_eyebrow')}
            </span>
            <h2 class="text-xl font-semibold text-on-primary tracking-tight mt-3">{t(translations, 'legal_page.warranty_title')}</h2>
            <p class="mt-2 text-[14px] leading-relaxed text-on-primary/90">{t(translations, 'legal_page.warranty_text')}</p>
            <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-on-primary/20">
              {[1, 2, 3].map((i) => (
                <div>
                  <div class="text-[11px] font-mono uppercase text-secondary-fixed font-semibold">{t(translations, `legal_page.warranty_tags.${i}.label`)}</div>
                  <div class="text-[12px] text-on-primary/80 mt-0.5">{t(translations, `legal_page.warranty_tags.${i}.text`)}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="pt-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm">
          <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-secondary font-semibold mb-2">
            <Icon name="verified" class="w-4 h-4" />
            {t(translations, 'legal_page.odr_eyebrow')}
          </div>
          <h2 class="text-xl font-semibold text-on-surface">{t(translations, 'legal_page.odr_title')}</h2>
          <p class="mt-2 text-[14px] text-on-surface-variant leading-relaxed max-w-3xl">{t(translations, 'legal_page.odr_text')}</p>
          <ul class="mt-4 flex flex-col gap-2 text-[13px]">
            {[1, 2].map((i) => (
              <li class="flex items-start gap-2">
                <Icon name="check" class="w-4 h-4 shrink-0 text-secondary mt-0.5" />
                <span class="text-on-surface-variant">{t(translations, `legal_page.odr_items.${i}`)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-surface-container-low rounded-xl p-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="flex flex-col gap-3">
            <h2 class="text-lg font-semibold text-on-surface">{t(translations, 'legal_page.contact_title')}</h2>
            <p class="text-[13.5px] text-on-surface-variant leading-relaxed">{t(translations, 'legal_page.contact_text')}</p>
            {legalConfigured ? (
              <div class="mt-2 p-4 rounded-lg bg-surface-container-lowest shadow-sm text-[13px]">
                <p class="font-semibold text-on-surface">{identity.name}</p>
                <p class="mt-1 text-on-surface-variant">{identity.address}</p>
                {identity.representative && <p class="mt-1 text-on-surface-variant">{identity.representative}</p>}
                <p class="mt-1">
                  <a class="text-secondary hover:underline font-medium" href={`mailto:${identity.email}`}>{identity.email}</a>
                </p>
                {identity.vat && <p class="mt-1 text-on-surface-variant">{identity.vat}</p>}
              </div>
            ) : (
              <div class="mt-2 p-4 rounded-lg bg-surface-container-lowest shadow-sm text-[13px] text-on-surface-variant">{t(translations, 'impressum.not_configured')}</div>
            )}
          </div>
          <div class="flex flex-col items-start justify-between gap-4">
            <div class="flex flex-col gap-3 w-full">
              <a href={`/${currentLang}/faq`} class="h-11 px-4 rounded-lg bg-primary text-on-primary font-medium inline-flex items-center justify-center gap-2 hover:bg-primary-container">
                <Icon name="scan" class="w-[18px] h-[18px]" />
                {t(translations, 'legal_page.contact_primary')}
              </a>
              <a href={`/${currentLang}/contact`} class="h-11 px-4 rounded-lg bg-surface-container-lowest hover:bg-surface-container text-on-surface font-medium inline-flex items-center justify-center gap-2 border border-outline-variant/40">
                <Icon name="chevron" class="w-[18px] h-[18px]" />
                {t(translations, 'legal_page.contact_secondary')}
              </a>
            </div>
            <p class="text-[12px] text-on-surface-variant">{t(translations, 'footer.client_side_note')}</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>