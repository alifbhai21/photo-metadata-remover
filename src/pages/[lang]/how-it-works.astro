---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Info/Icon.astro';
import Breadcrumbs from '../../components/Info/Breadcrumbs.astro';
import { getTranslations, t } from '../../i18n/index';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);

const nodeIcons = ['device', 'memory', 'scan', 'warning', 'remove', 'verified', 'download'];
const stepIcons = ['folder', 'scan', 'verified', 'remove', 'download'];
---

<Layout lang={currentLang} title={t(translations, 'how_it_works_page.title')} description={t(translations, 'seo.how_it_works.description')}>
  <div class="bg-background text-on-surface">
    <section class="overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-12">
        <Breadcrumbs current={t(translations, 'nav.how_it_works')} />
        <div class="mt-10 max-w-3xl flex flex-col gap-5">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed/40 text-secondary self-start shadow-sm">
            <span class="w-2 h-2 rounded-full bg-secondary" aria-hidden="true"></span>
            <span class="text-[11px] font-mono uppercase tracking-widest font-semibold">{t(translations, 'how_it_works_page.hero_badge')}</span>
          </span>
          <h1 class="text-[34px] sm:text-[42px] lg:text-[48px] font-semibold tracking-tight text-on-surface leading-[1.05]">{t(translations, 'how_it_works_page.title')}</h1>
          <p class="text-base sm:text-lg text-on-surface-variant leading-relaxed max-w-2xl">{t(translations, 'how_it_works_page.hero_lead')}</p>
          <p class="text-[14px] text-on-surface-variant">{t(translations, 'how_it_works_page.subtitle')}</p>
        </div>
      </div>
    </section>

    <section class="bg-surface-container-lowest border border-outline-variant/30 rounded-2xl max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
      <div class="p-6 md:p-8">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3 pb-3 border-b border-outline-variant/30">
          <div>
            <span class="block text-[11px] font-mono uppercase tracking-widest text-secondary font-semibold">{t(translations, 'how_it_works_page.flow_eyebrow')}</span>
            <h2 class="text-xl font-semibold text-on-surface mt-1">{t(translations, 'how_it_works_page.flow_title')}</h2>
          </div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed/30 text-secondary text-[11px] font-mono font-semibold">
            <Icon name="cloud_off" class="w-4 h-4" />
            {t(translations, 'how_it_works_page.flow_note')}
          </span>
        </div>
        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {[1, 2, 3, 4, 5, 6, 7].map((i) => (
            <div class="bg-surface-container-low rounded-xl p-4 group hover:bg-surface-container transition-colors">
              <div class="flex items-center justify-between mb-2">
                <span class="w-8 h-8 rounded-lg bg-surface-container-highest text-on-surface flex items-center justify-center font-mono text-[11px] font-bold">0{i}</span>
                <Icon name={nodeIcons[i - 1]} class="w-5 h-5 text-secondary" />
              </div>
              <span class="text-[14px] font-semibold text-on-surface">{t(translations, `how_it_works_page.nodes.${i}.title`)}</span>
              <span class="block mt-1 text-[12px] text-on-surface-variant">{t(translations, `how_it_works_page.nodes.${i}.text`)}</span>
              <span class="block mt-2 text-[10px] font-mono text-on-surface-variant/70">{t(translations, `how_it_works_page.nodes.${i}.tag`)}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="pt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <span class="block text-[11px] font-mono uppercase tracking-widest text-secondary font-semibold mb-2">{t(translations, 'how_it_works_page.steps_eyebrow')}</span>
          <h2 class="text-2xl font-semibold text-on-surface tracking-tight">{t(translations, 'how_it_works_page.steps_title')}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {[1, 2, 3, 4, 5].map((i) => (
            <div class={'bg-surface-container-lowest rounded-2xl p-6 shadow-sm flex flex-col justify-between gap-4 ' + (i === 5 ? 'md:col-span-2 lg:col-span-2' : '')}>
              <div>
                <div class="flex items-center justify-between">
                  <span class={'mr-auto px-2.5 py-1 rounded-md font-mono text-[11px] font-bold ' + (i === 4 ? 'bg-secondary text-on-secondary' : 'bg-surface-container text-on-surface')}>{t(translations, 'how_it_works_page.step_prefix')} 0{i}</span>
                  <Icon name={stepIcons[i - 1]} class="w-6 h-6 text-secondary" />
                </div>
                <h3 class="mt-3 text-[18px] font-semibold text-on-surface">{t(translations, `how_it_works_page.steps.${i}.title`)}</h3>
                <p class="mt-2 text-[14px] text-on-surface-variant leading-relaxed">{t(translations, `how_it_works_page.steps.${i}.text`)}</p>
              </div>
              <div class="inline-flex items-center gap-2 p-2.5 rounded-xl bg-surface-container-low text-[11px] font-mono text-on-surface-variant">
                <Icon name="check" class="w-4 h-4 text-secondary" />
                <span>{t(translations, `how_it_works_page.steps.${i}.badge`)}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="pt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8 max-w-2xl">
          <span class="block text-[11px] font-mono uppercase tracking-widest text-secondary font-semibold mb-2">{t(translations, 'how_it_works_page.compare_eyebrow')}</span>
          <h2 class="text-2xl font-semibold text-on-surface tracking-tight">{t(translations, 'how_it_works_page.compare_title')}</h2>
          <p class="mt-3 text-[14px] text-on-surface-variant">{t(translations, 'how_it_works_page.compare_intro')}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm flex flex-col gap-4">
            <div class="flex items-center justify-between pb-2 border-b border-outline-variant/30">
              <h3 class="text-[15px] font-semibold text-on-surface">{t(translations, 'how_it_works_page.remove_title')}</h3>
              <span class="shrink-0 px-2 py-0.5 rounded bg-error-container/40 text-on-error-container text-[10px] font-mono uppercase font-semibold">{t(translations, 'how_it_works_page.remove_badge')}</span>
            </div>
            <p class="text-[13px] text-on-surface-variant">{t(translations, 'how_it_works_page.remove_intro')}</p>
            <ul class="flex flex-col gap-2">
              {[1, 2, 3, 4, 5].map((i) => (
                <li class="flex items-start gap-2 p-2.5 rounded-lg bg-surface-container-low text-[13px]">
                  <Icon name="close" class="w-4 h-4 shrink-0 text-on-error-container mt-0.5" />
                  <span class="text-on-surface-variant">{t(translations, `how_it_works_page.remove_items.${i}`)}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm flex flex-col gap-4">
            <div class="flex items-center justify-between pb-2 border-b border-outline-variant/30">
              <h3 class="text-[15px] font-semibold text-on-surface">{t(translations, 'how_it_works_page.keep_title')}</h3>
              <span class="shrink-0 px-2 py-0.5 rounded bg-secondary-fixed/40 text-secondary text-[10px] font-mono uppercase font-semibold">{t(translations, 'how_it_works_page.keep_badge')}</span>
            </div>
            <p class="text-[13px] text-on-surface-variant">{t(translations, 'how_it_works_page.keep_intro')}</p>
            <ul class="flex flex-col gap-2">
              {[1, 2, 3, 4, 5].map((i) => (
                <li class="flex items-start gap-2 p-2.5 rounded-lg bg-surface-container-low text-[13px]">
                  <Icon name="check" class="w-4 h-4 shrink-0 text-secondary mt-0.5" />
                  <span class="text-on-surface-variant">{t(translations, `how_it_works_page.keep_items.${i}`)}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="mt-6 p-4 rounded-xl bg-secondary-fixed/20 flex items-center gap-4">
          <Icon name="verified" class="w-7 h-7 shrink-0 text-secondary" />
          <div>
            <span class="block text-[15px] font-semibold text-on-surface">{t(translations, 'how_it_works_page.lossless_title')}</span>
            <span class="block mt-1 text-[13px] text-on-surface-variant">{t(translations, 'how_it_works_page.lossless_text')}</span>
          </div>
        </div>
      </div>
    </section>
    <section class="pt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8 max-w-2xl">
          <span class="block text-[11px] font-mono uppercase tracking-widest text-secondary font-semibold mb-2">{t(translations, 'how_it_works_page.tech_eyebrow')}</span>
          <h2 class="text-2xl font-semibold text-on-surface tracking-tight">{t(translations, 'how_it_works_page.tech_title')}</h2>
          <p class="mt-3 text-[14px] text-on-surface-variant">{t(translations, 'how_it_works_page.tech_intro')}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {['privacy', 'technical'].map((card) => (
            <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm flex flex-col gap-4">
              <h3 class="text-[16px] font-semibold text-on-surface flex items-center gap-2">
                <Icon name={card === 'privacy' ? 'warning' : 'clock'} class="w-5 h-5 text-secondary" />
                {t(translations, `how_it_works_page.tech_cards.${card}.title`)}
              </h3>
              <div class="flex flex-col gap-2">
                {[1, 2, 3].map((j) => (
                  <div class="p-3 rounded-lg bg-surface-container-low text-[13px]">{t(translations, `how_it_works_page.tech_cards.${card}.items.${j}`)}</div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-surface-container-lowest rounded-2xl p-10 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="max-w-xl">
            <h2 class="text-2xl font-semibold text-on-surface tracking-tight">{t(translations, 'how_it_works_page.cta_title')}</h2>
            <p class="mt-2 text-[14px] text-on-surface-variant">{t(translations, 'how_it_works_page.cta_text')}</p>
          </div>
          <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
            <a href={`/${currentLang}/`} class="w-full sm:w-auto h-11 px-5 rounded-lg bg-primary text-on-primary font-medium inline-flex items-center justify-center gap-2 hover:bg-primary-container shadow-sm">
              <Icon name="upload" class="w-[18px] h-[18px]" />
              <span>{t(translations, 'how_it_works_page.cta_primary')}</span>
            </a>
            <a href={`/${currentLang}/security`} class="w-full sm:w-auto h-11 px-4 rounded-lg bg-surface-container-low text-on-surface hover:bg-surface-container font-medium inline-flex items-center justify-center gap-2">
              <span>{t(translations, 'how_it_works_page.cta_secondary')}</span>
              <Icon name="chevron" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>