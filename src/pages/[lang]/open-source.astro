---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Info/Icon.astro';
import Breadcrumbs from '../../components/Info/Breadcrumbs.astro';
import { getTranslations, t } from '../../i18n/index';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);

const principleIcons = ['close', 'verified', 'cloud_off'];
const verifyIcons = ['terminal', 'scan', 'cloud_off', 'upload', 'check'];
---

<Layout lang={currentLang} title={t(translations, 'open_source_page.title')} description={t(translations, 'seo.open_source.description')}>
  <div class="bg-background text-on-surface">
    <section class="overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-12">
        <Breadcrumbs current={t(translations, 'nav.open_source')} />
        <div class="mt-10 flex flex-col items-start gap-5 max-w-4xl">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-[11px] font-mono uppercase tracking-widest font-semibold shadow-sm">
            <span class="w-2 h-2 rounded-full bg-secondary" aria-hidden="true"></span>
            {t(translations, 'open_source_page.hero_badge')}
          </span>
          <h1 class="text-[32px] sm:text-[40px] lg:text-[48px] font-semibold tracking-tight text-on-surface leading-[1.05]">
            {t(translations, 'open_source_page.title')}.<br class="hidden sm:inline" />
            <span class="text-secondary font-semibold">{t(translations, 'open_source_page.title_2')}</span>
          </h1>
          <p class="text-base sm:text-lg text-on-surface-variant max-w-2xl leading-relaxed">{t(translations, 'open_source_page.subtitle')}</p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="https://github.com" rel="noopener noreferrer" target="_blank" class="inline-flex items-center gap-2 h-11 px-5 rounded-xl bg-primary text-on-primary font-medium shadow-md hover:bg-primary-container">
              <Icon name="github" class="w-5 h-5" />
              {t(translations, 'open_source_page.cta_primary')}
            </a>
            <a href={`/${currentLang}/`} class="inline-flex items-center gap-2 h-11 px-5 rounded-xl bg-surface-container text-on-surface font-medium hover:bg-surface-container-high">
              <Icon name="upload" class="w-5 h-5 text-secondary" />
              {t(translations, 'open_source_page.cta_secondary')}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="pt-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8 max-w-2xl">
          <span class="block text-[11px] font-mono uppercase tracking-widest text-secondary font-semibold mb-2">{t(translations, 'open_source_page.principles_eyebrow')}</span>
          <h2 class="text-2xl font-semibold text-on-surface tracking-tight">{t(translations, 'open_source_page.principles_title')}</h2>
          <p class="mt-2 text-[14px] text-on-surface-variant">{t(translations, 'open_source_page.principles_intro')}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {[1, 2, 3].map((i) => (
            <div class="bg-surface-container-lowest rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between gap-4">
              <div>
                <div class="w-10 h-10 rounded-lg bg-surface-container text-on-surface flex items-center justify-center"><Icon name={principleIcons[i - 1]} class="w-6 h-6" /></div>
                <h3 class="mt-3 text-[17px] font-semibold text-on-surface">{t(translations, `open_source_page.principles.${i}.title`)}</h3>
                <p class="mt-2 text-[13.5px] text-on-surface-variant leading-relaxed">{t(translations, `open_source_page.principles.${i}.text`)}</p>
              </div>
              <div class="inline-flex items-center gap-2 p-2.5 rounded-lg bg-surface-container-low text-[11px] font-mono text-on-surface-variant">
                <Icon name="check" class="w-4 h-4 text-secondary" />
                {t(translations, `open_source_page.principles.${i}.note`)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="pt-14 bg-surface-container-lowest">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-6 max-w-2xl">
          <span class="block text-[11px] font-mono uppercase tracking-widest text-secondary font-semibold mb-2">{t(translations, 'open_source_page.code_eyebrow')}</span>
          <h2 class="text-2xl font-semibold text-on-surface tracking-tight">{t(translations, 'open_source_page.code_title')}</h2>
          <p class="mt-2 text-[14px] text-on-surface-variant">{t(translations, 'open_source_page.code_intro')}</p>
        </div>
        <div class="rounded-xl bg-primary text-on-primary p-6 shadow-xl overflow-hidden">
          <div class="flex items-center justify-between pb-2">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-error" aria-hidden="true"></span>
              <span class="w-3 h-3 rounded-full bg-secondary-fixed" aria-hidden="true"></span>
              <span class="w-3 h-3 rounded-full bg-surface-tint" aria-hidden="true"></span>
              <span class="ml-2 font-mono text-[11px] text-primary-fixed-dim">src/core/sanitizer.ts</span>
            </div>
            <span class="font-mono text-[10px] uppercase text-secondary-fixed">{t(translations, 'open_source_page.code_note')}</span>
          </div>
          <pre class="mt-3 font-mono text-[11.5px] leading-relaxed overflow-x-auto text-primary-fixed-dim"><code>{t(translations, 'open_source_page.code_block')}</code></pre>
        </div>
      </div>
    </section>
    <section class="pt-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8 max-w-2xl">
          <span class="block text-[11px] font-mono uppercase tracking-widest text-secondary font-semibold mb-2">{t(translations, 'open_source_page.verify_eyebrow')}</span>
          <h2 class="text-2xl font-semibold text-on-surface tracking-tight">{t(translations, 'open_source_page.verify_title')}</h2>
          <p class="mt-2 text-[14px] text-on-surface-variant">{t(translations, 'open_source_page.verify_intro')}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
          {[1, 2, 3, 4, 5].map((i) => (
            <div class="bg-surface-container-lowest rounded-xl p-4 shadow-sm flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <span class="w-7 h-7 rounded-full bg-primary text-on-primary font-mono text-[11px] font-bold flex items-center justify-center shrink-0">{i}</span>
                <Icon name={verifyIcons[i - 1]} class="w-4 h-4 text-secondary" />
              </div>
              <span class="text-[14px] font-semibold text-on-surface mt-2">{t(translations, `open_source_page.verify_steps.${i}.title`)}</span>
              <span class="text-[12px] text-on-surface-variant leading-relaxed">{t(translations, `open_source_page.verify_steps.${i}.text`)}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pt-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8 max-w-2xl">
          <span class="block text-[11px] font-mono uppercase tracking-widest text-secondary font-semibold mb-2">{t(translations, 'open_source_page.contribute_eyebrow')}</span>
          <h2 class="text-2xl font-semibold text-on-surface tracking-tight">{t(translations, 'open_source_page.contribute_title')}</h2>
          <p class="mt-2 text-[14px] text-on-surface-variant">{t(translations, 'open_source_page.contribute_intro')}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {[1, 2, 3].map((i) => (
            <div class="bg-surface-container-low rounded-xl p-6 flex flex-col justify-between gap-3">
              <div>
                <h3 class="text-[16px] font-semibold text-on-surface">{t(translations, `open_source_page.contribute.${i}.title`)}</h3>
                <p class="mt-2 text-[13px] text-on-surface-variant">{t(translations, `open_source_page.contribute.${i}.text`)}</p>
              </div>
              <a href="https://github.com" rel="noopener noreferrer" target="_blank" class="text-[12px] font-mono font-semibold text-on-surface hover:text-secondary inline-flex items-center gap-1">
                {t(translations, `open_source_page.contribute.${i}.link`)}<Icon name="chevron" class="w-4 h-4" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-surface-container-highest rounded-2xl p-8 md:p-10 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="max-w-xl">
            <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-wider text-secondary font-semibold">
              <Icon name="verified" class="w-4 h-4" />
              {t(translations, 'open_source_page.hero_badge')}
            </div>
            <h3 class="text-2xl font-semibold text-on-surface tracking-tight mt-1">{t(translations, 'open_source_page.cta_title')}</h3>
            <p class="mt-2 text-[14px] text-on-surface-variant">{t(translations, 'open_source_page.cta_text')}</p>
          </div>
          <div class="flex flex-col sm:flex-row sm:flex-wrap items-center justify-center gap-3 w-full md:w-auto">
            <a href={`/${currentLang}/security`} class="w-full sm:w-auto h-11 px-5 rounded-lg bg-surface-container text-on-surface font-medium inline-flex items-center justify-center gap-2 hover:bg-surface-bright">
              <Icon name="lock" class="w-[18px] h-[18px]" />
              {t(translations, 'open_source_page.cta_primary')}
            </a>
            <a href={`/${currentLang}/`} class="w-full sm:w-auto h-11 px-5 rounded-lg bg-primary text-on-primary font-medium inline-flex items-center justify-center gap-2 shadow hover:bg-primary-container">
              <Icon name="upload" class="w-[18px] h-[18px]" />
              {t(translations, 'open_source_page.cta_secondary')}
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>