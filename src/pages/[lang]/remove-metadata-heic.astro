---
import Layout from '../../layouts/Layout.astro';
import ToolUpload from '../../components/ToolUpload.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import Features from '../../components/Features.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import RiskAudit from '../../components/RiskAudit.astro';
import Fidelity from '../../components/Fidelity.astro';
import SelectedArticles from '../../components/SelectedArticles.astro';
import FAQ from '../../components/FAQ.astro';
import { getTranslations, t } from '../../i18n/index';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);
const toolSlug = 'remove-metadata-heic';

const SITE_URL = (Astro.site?.origin ?? 'https://photometadataremover.com').replace(/\/$/, '');
const pageUrl = `${SITE_URL}/${currentLang}/${toolSlug}/`;

const features = [1, 2, 3].map((n) => ({
  title: t(translations, `tools.${toolSlug}.features.${n}.title`),
  text: t(translations, `tools.${toolSlug}.features.${n}.text`),
}));

const steps = [1, 2, 3].map((n) => ({
  text: t(translations, `tools.${toolSlug}.how_steps.${n}.text`),
}));

const faq = [1, 2, 3].map((n) => ({
  question: t(translations, `tools.${toolSlug}.faq.${n}.question`),
  answer: t(translations, `tools.${toolSlug}.faq.${n}.answer`),
}));

const heicNote = t(translations, `tools.${toolSlug}.note`);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(translations, 'site.name'),
      item: `${SITE_URL}/${currentLang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(translations, `tools.${toolSlug}.title`),
      item: pageUrl,
    },
  ],
};

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: t(translations, `tools.${toolSlug}.title`),
  description: t(translations, `seo.tools.${toolSlug}.description`),
  url: pageUrl,
  inLanguage: currentLang,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any',
  featureList: features.map((f) => f.text),
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  lang={currentLang}
  title={t(translations, `seo.tools.${toolSlug}.title`)}
  description={t(translations, `seo.tools.${toolSlug}.description`)}
  noindex
  jsonLd={[breadcrumbJsonLd, softwareJsonLd, faqJsonLd]}
>
  <!-- ============================ HEIC hero (homepage visual language) ============================ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-8 overflow-hidden">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50 border border-brand-200 text-brand-800 text-xs font-semibold tracking-wide">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2z" />
        </svg>
        <span>{t(translations, 'nav.client_side_badge')}</span>
      </div>
      <h1 class="mt-4 text-4xl sm:text-5xl lg:text-[56px] font-extrabold text-slate-900 tracking-tight leading-[1.08]">
        {t(translations, `tools.${toolSlug}.title`)}
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed font-normal">
        {t(translations, `tools.${toolSlug}.subtitle`)}
      </p>
      <div class="mt-6 inline-flex items-center gap-2 text-[13px] text-slate-600">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-50 border border-slate-200/80 text-slate-700">
          <svg class="w-3.5 h-3.5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          {t(translations, 'tool.formats_line')}
        </span>
      </div>
    </div>
  </section>

  <!-- ============================ HEIC note (preserved warning) ============================ -->
  {heicNote && heicNote !== `tools.${toolSlug}.note` && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-2">
      <div class="max-w-3xl">
        <div class="bg-warning-bg border border-warning-border rounded-2xl px-4 py-3 text-[13.5px] text-warning-text">
          {heicNote}
        </div>
      </div>
    </section>
  )}

  <!-- ============================ Tool Workspace (matches homepage 12-col grid) ============================ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6" data-purpose="interactive-tool-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left: main upload & processing card -->
      <div class="lg:col-span-8 bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200/80">
        <!-- Stepper navigation bar (matches homepage) -->
        <div class="flex flex-wrap items-center justify-between gap-y-2 border-b border-slate-100 pb-5 mb-8 text-xs font-semibold text-slate-400">
          <div class="flex items-center gap-2 text-brand-700 bg-brand-50/80 px-3.5 py-1.5 rounded-full border border-brand-200/60" aria-label={t(translations, 'tool.step_upload')}>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            </svg>
            <span>{t(translations, 'tool.step_upload')}</span>
          </div>
          <div class="h-px bg-slate-200 w-8 hidden sm:block" aria-hidden="true"></div>
          <div class="flex items-center gap-2 hover:text-slate-600 transition-colors" aria-label={t(translations, 'tool.step_scan')}>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" x2="16.65" y1="21" y2="16.65" />
            </svg>
            <span>{t(translations, 'tool.step_scan')}</span>
          </div>
          <div class="h-px bg-slate-200 w-8 hidden sm:block" aria-hidden="true"></div>
          <div class="flex items-center gap-2 hover:text-slate-600 transition-colors" aria-label={t(translations, 'tool.step_remove')}>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 9.75l2.25 2.25M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{t(translations, 'tool.step_remove')}</span>
          </div>
          <div class="h-px bg-slate-200 w-8 hidden sm:block" aria-hidden="true"></div>
          <div class="flex items-center gap-2 hover:text-slate-600 transition-colors" aria-label={t(translations, 'tool.step_download')}>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" x2="12" y1="15" y2="3" />
            </svg>
            <span>{t(translations, 'tool.step_download')}</span>
          </div>
        </div>

        <ToolUpload lang={currentLang} />
      </div>

      <!-- Right: informative side cards (mirrors homepage) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200/80">
          <div class="flex items-center gap-3.5 mb-3">
            <div class="w-9 h-9 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-700" aria-hidden="true">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900 tracking-tight">{t(translations, 'sidebar.privacy.title')}</h3>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">{t(translations, 'sidebar.privacy.desc')}</p>
          <ul class="space-y-2.5 text-xs text-slate-700">
            {[0, 1, 2, 3].map((i) => (
              <li class="flex items-center gap-2.5 font-medium">
                <span class="w-4 h-4 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center shrink-0" aria-hidden="true">✓</span>
                <span>{t(translations, `sidebar.privacy.items.${i}`)}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200/80">
          <div class="flex items-center gap-3.5 mb-3">
            <div class="w-9 h-9 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-700" aria-hidden="true">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <polyline points="14 2 14 8 20 8" />
                <line x1="16" x2="8" y1="13" y2="13" />
                <line x1="16" x2="8" y1="17" y2="17" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900 tracking-tight">{t(translations, 'sidebar.removed.title')}</h3>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">{t(translations, 'sidebar.removed.desc')}</p>
          <ul class="space-y-2.5 text-xs text-slate-700">
            {[0, 1, 2, 3, 4].map((i) => (
              <li class="flex items-center gap-2.5 font-medium">
                <span class="w-4 h-4 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center shrink-0" aria-hidden="true">✓</span>
                <span>{t(translations, `sidebar.removed.items.${i}`)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ HEIC intro (EXIF-specific copy preserved) ============================ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200/80">
      <p class="text-[15.5px] text-slate-600 leading-relaxed max-w-3xl">
        {t(translations, `tools.${toolSlug}.intro`)}
      </p>
    </div>
  </section>

  <!-- ============================ HEIC features (3 cards, homepage visual language) ============================ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" data-purpose="heic-features">
    <div class="mb-8">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-50 border border-brand-200/60 text-brand-800 text-[11px] font-semibold tracking-wider uppercase">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-700"></span>
        {t(translations, `tools.${toolSlug}.features_title`)}
      </span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {features.map((feature, i) => (
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200/80 flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-700 font-mono text-[12px] font-medium" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </div>
              <h3 class="text-sm font-bold text-slate-900 tracking-tight">{feature.title}</h3>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">
              {feature.text}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================ HEIC how-to (3 steps, homepage visual language) ============================ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 border-t border-slate-200/70" data-purpose="heic-how">
    <div class="max-w-5xl">
      <div class="max-w-2xl mb-8 sm:mb-12">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-50 border border-brand-200/60 text-brand-800 text-[11px] font-semibold tracking-wider uppercase">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-700"></span>
          {t(translations, 'how_it_works.eyebrow')}
        </span>
        <h2 class="mt-3 text-[28px] sm:text-[36px] font-semibold tracking-tight text-slate-900 leading-[1.1]">
          {t(translations, `tools.${toolSlug}.how_title`)}
        </h2>
      </div>
      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {steps.map((step, i) => (
          <li class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200/80">
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-[12px] tracking-wider text-slate-400">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-brand-50 border border-brand-100 text-brand-700" aria-hidden="true">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  {i === 0 && <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 7.5m0 0L7.5 12M12 7.5v9" />}
                  {i === 1 && <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />}
                  {i === 2 && <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />}
                </svg>
              </span>
            </div>
            <p class="text-[14px] text-slate-700 leading-relaxed">
              {step.text}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============================ HEIC FAQ (homepage visual language, 2-col grid) ============================ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 border-t border-slate-200/70" data-purpose="heic-faq">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <h2 class="text-2xl font-bold text-slate-900 tracking-tight">{t(translations, `tools.${toolSlug}.faq_title`)}</h2>
      <a href={'/' + currentLang + '/faq'} class="text-xs font-semibold text-brand-700 hover:text-brand-800 inline-flex items-center gap-1">
        <span>{t(translations, 'faq.more')}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {faq.map((item) => (
        <details class="group bg-white rounded-2xl p-5 border border-slate-200/80 [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between gap-4 font-semibold text-sm text-slate-800 min-h-[44px]">
            <span>{item.question}</span>
            <span class="text-slate-400 group-open:rotate-45 transition-transform text-lg leading-none" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-xs text-slate-500 leading-relaxed border-t border-slate-100 pt-3">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- ============================ Homepage informational sections (reused from homepage) ============================ -->
  <Features lang={currentLang} />
  <HowItWorks lang={currentLang} />
  <RiskAudit lang={currentLang} />
  <Fidelity lang={currentLang} />
  <SelectedArticles lang={currentLang} />
  <FAQ lang={currentLang} items={faq} />

  <TrustStrip lang={currentLang} />
</Layout>