---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getTranslations, t } from '../../../i18n/index';

export function getStaticPaths() {
  const langs = ['en', 'de', 'fr'] as const;
  const slugs = ['what-is-exif', 'gps-privacy', 'social-media'];
  const paths = [];
  for (const lang of langs) {
    for (const slug of slugs) {
      paths.push({ params: { lang, slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'de' | 'fr';

const guides = await getCollection('guides');
const entry = guides.find((g) => g.data.lang === currentLang && g.data.slug === slug);

if (!entry) {
  throw new Error(`Missing guide content for ${currentLang}/${slug}`);
}

const { Content } = await render(entry);
const translations = getTranslations(currentLang);

const others = guides.filter((g) => g.data.lang === currentLang && g.data.slug !== slug);

const SITE_URL = (Astro.site?.origin ?? 'https://photometadataremover.com').replace(/\/$/, '');
const articleUrl = `${SITE_URL}/${currentLang}/guides/${slug}/`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t(translations, 'site.name'),
      item: `${SITE_URL}/${currentLang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(translations, 'guides.title'),
      item: `${SITE_URL}/${currentLang}/guides/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: articleUrl,
    },
  ],
};

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.published.toISOString(),
  dateModified: entry.data.updated?.toISOString() ?? entry.data.published.toISOString(),
  inLanguage: currentLang,
  mainEntityOfPage: articleUrl,
};
---

<Layout
  lang={currentLang}
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  jsonLd={[breadcrumbJsonLd, articleJsonLd]}
>
  <article class="py-20 px-4">
    <div class="max-w-3xl mx-auto">
      <nav class="text-sm text-text-muted mb-6" aria-label="breadcrumb">
        <a href={`/${currentLang}`} class="hover:text-accent">Home</a>
        <span class="mx-2">/</span>
        <a href={`/${currentLang}/guides`} class="hover:text-accent">{t(translations, 'guides.title')}</a>
        <span class="mx-2">/</span>
        <span>{entry.data.title}</span>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-bold text-text mb-4">{entry.data.title}</h1>
      <p class="text-xl text-text-muted mb-8">{entry.data.description}</p>

      <div class="article-body prose space-y-6 text-text">
        <Content />
      </div>

      <div class="mt-12 pt-8 border-t border-border">
        <a
          href={`/${currentLang}/#tool`}
          class="inline-flex items-center rounded-full bg-accent-btn text-accent-btn-text px-6 py-3 font-medium hover:bg-accent-btn-hover transition-colors"
        >
          {t(translations, 'guides.cta')}
        </a>
      </div>

      {others.length > 0 && (
        <div class="mt-12">
          <h2 class="text-xl font-semibold text-text mb-4">{t(translations, 'guides.related')}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {others.map((o) => (
              <a
                href={`/${currentLang}/guides/${o.data.slug}`}
                class="block p-4 bg-surface rounded-xl border border-border hover:shadow-lg transition-shadow"
              >
                <h3 class="text-base font-semibold text-text mb-1">{o.data.title}</h3>
                <p class="text-sm text-text-muted">{o.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</Layout>

<style>
  .article-body h2 {
    font-size: 1.75rem;
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .article-body h3 {
    font-size: 1.25rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .article-body p {
    margin: 1rem 0;
    line-height: 1.75;
    color: var(--color-text-muted);
  }
  .article-body ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 1rem 0;
    color: var(--color-text-muted);
  }
  .article-body li {
    margin: 0.5rem 0;
    line-height: 1.6;
  }
  .article-body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .article-body a:hover {
    color: var(--color-accent-hover);
  }
  .article-body strong {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
