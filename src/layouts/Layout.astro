          <!-- Trust & languages column -->
          <div>
            <h4 class="text-[13px] font-semibold text-on-surface mb-4">{t(translations, 'footer.trust_title')}</h4>
            <ul class="flex flex-col gap-2.5 text-[13px] text-on-surface-variant">
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0 mt-[7px]" aria-hidden="true"></span>
                <span>{t(translations, 'footer.trust.0')}</span>
