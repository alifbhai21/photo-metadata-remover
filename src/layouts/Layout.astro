---
import '../styles/global.css';
import { getTranslations, t } from '../i18n/index';
import { SUPPORTED_LANGS, LANG_LABELS } from '../lib/lang';
import { isAnalyticsEnabled } from '../lib/analytics';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  /**
   * Optional verbatim `<title>`. Used by the homepage, whose SEO title is
   * already fully qualified ("Photo Metadata Remover Online — Remove EXIF &
   * GPS Data") and must not get the generic " | <site name>" suffix appended.
   * Omit everywhere else to keep the existing suffix behaviour.
   */
  fullTitle?: string;
  /** Optional OG description override (falls back to `description`). */
  ogDescription?: string;
  /** Optional Twitter description override (falls back to `description`). */
  twitterDescription?: string;
}

const {
  title = 'Photo Metadata Remover',
  description = 'Remove EXIF data from your photos. Privacy-first, free, no uploads.',
  lang = 'en',
  ogType = 'website',
  jsonLd,
  noindex = false,
  fullTitle,
  ogDescription,
  twitterDescription,
} = Astro.props;

const currentLang = ((SUPPORTED_LANGS as readonly string[]).includes(lang) ? lang : 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);
const siteName = t(translations, 'site.name');

const SITE_URL = (Astro.site?.origin ?? 'https://photometadataremover.com').replace(/\/$/, '');

const analyticsEnabled = isAnalyticsEnabled();
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined;
const plausibleScriptSrc =
  (import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_SRC as string | undefined) ?? 'https://plausible.io/js/script.js';
const plausibleApiHost = import.meta.env.PUBLIC_PLAUSIBLE_API_HOST as string | undefined;

const pathWithoutLocale = Astro.url.pathname
  .replace(/^\/(en|de|fr)(?=\/|$)/, '')
  .replace(/\/$/, '') || '/';

const switchHref = (l: string) => `/${l}${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`;

// `fullTitle` (verbatim, homepage SEO title) wins when supplied; otherwise keep
// the historical "<title> | <site name>" pattern used by every other page.
const resolvedTitle = fullTitle ?? `${title} | ${siteName}`;
const resolvedOgDescription = ogDescription ?? description;
const resolvedTwitterDescription = twitterDescription ?? description;

const localize = (l: string) => `${SITE_URL}/${l}${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`;
const canonicalUrl = localize(currentLang);

const ogImageUrl = `${SITE_URL}/og-image.png`;

const ogLocale = { en: 'en_US', de: 'de_DE', fr: 'fr_FR' }[currentLang];

const jsonLdBlocks = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

// Privacy badge copy — localized, with a safe fallback
const privacyBadgeText = t(translations, 'nav.client_side_badge');

/* ---------------------------------------------------------------------------
 * Mobile / tablet drawer navigation (Google Stitch export).
 *
 * Visual source of truth: the provided Stitch mobile/tablet exports.
 * Functional source of truth: this project. The entries below reuse the
 * project's existing public routes and existing localized labels — no new
 * routes, no new pages. The hidden secondary tools (view-photo-metadata,
 * remove-exif-data, remove-gps-data, remove-metadata-heic) are deliberately
 * NOT listed here, exactly as they are absent from the desktop navbar.
 * --------------------------------------------------------------------- */
const normalizePath = (p: string) => p.replace(/\/+$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);

const drawerNav = [
  { label: t(translations, 'nav.home'), href: `/${lang}/` },
  { label: t(translations, 'nav.metadata'), href: `/${lang}/formats` },
  { label: t(translations, 'nav.guides'), href: `/${lang}/guides` },
  { label: t(translations, 'nav.faq'), href: `/${lang}/faq` },
  { label: t(translations, 'nav.about'), href: `/${lang}/about` },
  { label: t(translations, 'nav.privacy'), href: `/${lang}/privacy` },
  { label: t(translations, 'nav.security'), href: `/${lang}/security` },
].map((item) => ({ ...item, active: normalizePath(item.href) === currentPath }));

/** Language section label — reuse the existing localized footer string. */
const drawerLanguageLabel = t(translations, 'footer.languages');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#f7f9f7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={localize('en')} />
    <link rel="alternate" hreflang="de" href={localize('de')} />
    <link rel="alternate" hreflang="fr" href={localize('fr')} />
    <link rel="alternate" hreflang="x-default" href={localize('en')} />

    <title>{resolvedTitle}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={t(translations, 'seo.og_image_alt')} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedTwitterDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={t(translations, 'seo.og_image_alt')} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {analyticsEnabled && (
      <script
        defer
        data-domain={plausibleDomain}
        data-api={plausibleApiHost ? `${plausibleApiHost.replace(/\/$/, '')}/api/event` : undefined}
        src={plausibleScriptSrc}
      />
    )}

    <!-- Fonts — Inter per the PhotoGuard design -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-bg text-text antialiased">
    <!-- Skip to content link for keyboard / screen-reader users -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:px-4 focus:py-2 focus:bg-surface focus:text-text focus:border focus:border-border focus:rounded-lg focus:text-sm focus:font-medium"
    >
      {t(translations, 'nav.skip_to_content')}
    </a>

    <!-- ============================== Navigation ============================== -->
    <nav
      class="sticky top-0 left-0 right-0 z-50 bg-surface-container-lowest/80 backdrop-blur-xl border-b border-outline-variant/30 relative"
      aria-label="Primary"
    >
      <!-- Desktop navigation row. Below the `lg` breakpoint this whole row is
           replaced by the Stitch mobile/tablet header + drawer below, so the
           desktop composition at 1280/1440 is left exactly as it was. -->
      <div id="nav-fit" class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 min-h-20 hidden lg:flex flex-nowrap items-center justify-between gap-2 sm:gap-4">
        <!-- Brand logo & title -->
        <a href={`/${lang}`} class="flex items-center gap-3.5 group shrink max-w-[45%]" aria-label={t(translations, 'site.name')}>
          <span
            class="w-11 h-11 rounded-xl bg-primary flex items-center justify-center text-on-primary shadow-sm transition-transform group-hover:scale-105"
            aria-hidden="true"
          >
            <!-- Camera icon (privacy-guard aesthetic) -->
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" />
            </svg>
          </span>
          <span class="flex flex-col min-w-0">
            <span class="text-lg sm:text-xl font-bold text-on-surface tracking-tight leading-none truncate">
              {t(translations, 'site.name')}
            </span>
            <span class="block text-xs text-on-surface-variant font-medium mt-0.5 truncate">
              {t(translations, 'site.tagline')}
            </span>
          </span>
        </a>

        <!-- Desktop navigation menu (always visible; the single navbar row pans
             horizontally on narrow viewports instead of wrapping) -->
        <div class="flex flex-nowrap items-center gap-x-5 text-sm font-medium text-on-surface-variant whitespace-nowrap">
          <a href={`/${lang}/`} class="text-on-surface font-semibold hover:text-on-surface transition-colors">{t(translations, 'nav.home')}</a>
          <a href={`/${lang}/formats`} class="hover:text-on-surface transition-colors">{t(translations, 'nav.metadata')}</a>
          <a href={`/${lang}/guides`} class="hover:text-on-surface transition-colors">{t(translations, 'nav.guides')}</a>
          <a href={`/${lang}/faq`} class="hover:text-on-surface transition-colors">{t(translations, 'nav.faq')}</a>
          <a href={`/${lang}/about`} class="hover:text-on-surface transition-colors">{t(translations, 'nav.about')}</a>
          <a href={`/${lang}/privacy`} class="hover:text-on-surface transition-colors">{t(translations, 'nav.privacy')}</a>
        </div>

        <!-- RIGHT (always): language + primary CTA + mobile menu -->
        <div class="flex flex-nowrap items-center gap-2 shrink-0">
          <!-- Language Switcher -->
          <div>
            <button
              id="lang-toggle"
              type="button"
              class="inline-flex items-center gap-1 h-11 px-2.5 text-[13px] text-on-surface-variant hover:text-on-surface transition-colors rounded-lg hover:bg-surface-container-low"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label={t(translations, 'nav.change_language')}
              aria-controls="lang-dropdown"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              <span class="uppercase font-medium tracking-wide">{currentLang}</span>
            </button>
            </div>

          <!-- Primary CTA — "Remove Now" (localized, preserves existing routing) -->
          <a
            id="nav-cta"
            href={`/${lang}/`}
            class="inline-flex items-center gap-1.5 h-11 px-4 sm:px-5 rounded-full bg-primary text-on-primary text-[13px] font-medium whitespace-nowrap hover:bg-primary-container transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2" />
            </svg>
            <span class="hidden sm:inline">{t(translations, 'nav.remove_now')}</span>
            <span class="sm:hidden" aria-hidden="true">{t(translations, 'nav.remove_now_short')}</span>
          </a>

          </div>
      </div>

      <!-- ============ Mobile / tablet header (Google Stitch) ============
           Phone 375/390 and tablet 768/820 only. `lg:hidden` keeps it out of
           the 1280/1440 desktop composition entirely. Brand lockup, routes and
           labels come from the existing project data; the bar itself follows
           the provided Stitch export (64px phone, 68px tablet, logo left,
           hamburger right). The sticky <nav> already supplies the translucent
           background + bottom hairline, so the bar does not add its own. -->
      <div class="lg:hidden h-16 md:h-[68px] px-4 md:px-6 flex items-center justify-between gap-3">
        <a href={`/${lang}`} class="flex items-center gap-3 min-w-0" aria-label={t(translations, 'site.name')}>
          <span class="w-9 h-9 md:w-10 md:h-10 rounded-lg bg-primary flex items-center justify-center text-on-primary shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" />
            </svg>
          </span>
          <span class="flex flex-col min-w-0">
            <span class="text-[15px] md:text-[17px] font-semibold text-on-surface leading-tight truncate">
              {t(translations, 'site.name')}
            </span>
            <span class="text-[9px] md:text-[10px] font-mono font-medium uppercase tracking-[0.08em] text-zinc-500 leading-tight truncate">
              {privacyBadgeText}
            </span>
          </span>
        </a>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="w-11 h-11 md:w-12 md:h-12 rounded-lg bg-zinc-100 flex flex-col items-center justify-center gap-1.5 shrink-0 hover:bg-zinc-200 transition-colors active:scale-[0.98]"
          aria-label={t(translations, 'nav.menu')}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="block w-[18px] md:w-5 h-[1.5px] rounded-full bg-on-surface" aria-hidden="true"></span>
          <span class="block w-[18px] md:w-5 h-[1.5px] rounded-full bg-on-surface" aria-hidden="true"></span>
          <span class="block w-[18px] md:w-5 h-[1.5px] rounded-full bg-on-surface" aria-hidden="true"></span>
        </button>
      </div>
      <div
        id="lang-dropdown"
        class="hidden absolute right-0 top-full mt-2 w-40 bg-surface-container-lowest rounded-xl shadow-lg border border-outline-variant/50 py-1.5 z-50 pmr-elev-2"
        role="menu"
        aria-label={t(translations, 'nav.change_language')}
      >
        {SUPPORTED_LANGS.map((l) => (
          <a
            href={switchHref(l)}
            hreflang={l}
            lang={l}
            data-lang-switch={l}
            aria-current={currentLang === l ? 'page' : undefined}
            class={`block px-3 py-2 min-h-[44px] text-[13.5px] hover:bg-surface-container-low transition-colors ${currentLang === l ? 'text-secondary font-medium' : 'text-on-surface'}`}
            role="menuitem"
          >
            {LANG_LABELS[l]}
          </a>
        ))}
      </div>

    </nav>

      <!-- ============ Mobile / tablet drawer (Google Stitch) ============
           Right-side slide-in panel: 300px on phones, 360px on tablets, over a
           40% near-black scrim with a 2px backdrop blur. Hidden by default and
           `lg:hidden`, so it can never affect the desktop viewport.

           `hidden` is load-bearing, not vestigial: `setDrawer()` toggles this very
           class to open and close the drawer and `drawerIsOpen()` reads it back to
           decide whether the drawer is currently open. Removing the class would
           also defeat the Tailwind `hidden` utility, leaving the drawer pinned
           open over the whole viewport and the page-scroll lock unreachable. It
           must stay. -->
      <div
        id="mobile-menu"
        class="hidden lg:hidden fixed inset-0 z-[60]"
        role="dialog"
        aria-modal="true"
        aria-label={t(translations, 'nav.menu')}
      >
        <div class="pmr-drawer-backdrop absolute inset-0 bg-zinc-950/40 backdrop-blur-[2px]"></div>

        <div class="pmr-drawer-panel relative ml-auto w-[300px] md:w-[360px] h-full bg-surface-container-lowest border-l border-zinc-200 shadow-[-16px_0_24px_rgba(9,9,11,0.10)] md:shadow-[-20px_0_25px_-5px_rgba(9,9,11,0.12)] flex flex-col overflow-hidden">
          <!-- Drawer header row: brand + close -->
          <div class="flex items-center justify-between gap-3 h-14 md:h-16 px-5 md:px-6 pb-4 border-b border-zinc-200 shrink-0">
            <a href={`/${lang}`} class="flex items-center gap-3 min-w-0" aria-label={t(translations, 'site.name')}>
              <span class="w-9 h-9 md:w-10 md:h-10 rounded-lg bg-primary flex items-center justify-center text-on-primary shrink-0" aria-hidden="true">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" />
                </svg>
              </span>
              <span class="flex flex-col min-w-0">
                <span class="text-[15px] md:text-[17px] font-semibold text-on-surface leading-tight truncate">
                  {t(translations, 'site.name')}
                </span>
                <span class="text-[9px] md:text-[10px] font-mono font-medium uppercase tracking-[0.08em] text-zinc-500 leading-tight truncate">
                  {privacyBadgeText}
                </span>
              </span>
            </a>
            <button
              type="button"
              class="pmr-drawer-close w-11 h-11 md:w-12 md:h-12 rounded-lg bg-zinc-100 flex items-center justify-center text-on-surface hover:bg-zinc-200 transition-colors shrink-0"
              aria-label={t(translations, 'nav.menu')}
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
              </svg>
            </button>
          </div>

          <!-- Navigation list -->
          <nav class="flex-1 py-4 md:py-6 flex flex-col gap-1 overflow-y-auto" aria-label={t(translations, 'nav.menu')}>
            {drawerNav.map((item) => (
              <a
                data-nav-item
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
                class={`relative flex items-center h-12 md:h-14 px-3 md:px-4 rounded-lg text-[15px] md:text-[16px] transition-colors ${
                  item.active
                    ? 'bg-emerald-50 text-emerald-600 font-semibold'
                    : 'text-on-surface hover:bg-zinc-100'
                }`}
              >
                {item.active && (
                  <span class="absolute left-0 top-2 bottom-2 w-[3px] bg-emerald-500 rounded-r" aria-hidden="true"></span>
                )}
                {item.label}
              </a>
            ))}
          </nav>

          <!-- Language section — existing project language logic:
               switchHref() keeps the localized path, data-lang-switch is
               already bound to saveLang() + analytics by the script below. -->
          <div class="px-5 md:px-6 py-4 border-t border-zinc-200 shrink-0">
            <span class="block mb-3 text-[11px] font-mono font-medium uppercase tracking-[0.06em] text-zinc-500">
              {drawerLanguageLabel}
            </span>
            <div class="grid grid-cols-3 gap-2">
              {SUPPORTED_LANGS.map((l) => (
                <a
                  href={switchHref(l)}
                  hreflang={l}
                  lang={l}
                  data-lang-switch={l}
                  aria-current={currentLang === l ? 'page' : undefined}
                  class={`flex items-center justify-center h-11 md:h-12 rounded-lg border border-zinc-200 text-[14px] md:text-[15px] transition-colors ${
                    currentLang === l
                      ? 'bg-zinc-100 text-on-surface font-semibold'
                      : 'bg-surface-container-lowest text-on-surface md:text-zinc-500 hover:bg-zinc-100'
                  }`}
                >
                  {LANG_LABELS[l]}
                </a>
              ))}
            </div>
          </div>

          <!-- Primary CTA — same destination as the existing desktop #nav-cta -->
          <div class="px-5 md:px-6 pt-4 pb-5 md:pb-6 border-t border-zinc-200 shrink-0">
            <a
              id="mobile-nav-cta"
              class="pmr-drawer-cta flex items-center justify-center gap-2 w-full h-[52px] md:h-14 rounded-lg bg-primary text-on-primary text-[15px] md:text-[16px] font-semibold hover:bg-primary-container transition-colors"
              href={`/${lang}/`}
            >
              <svg class="w-[18px] h-[18px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
              </svg>
              {t(translations, 'nav.remove_now')}
            </a>
          </div>
        </div>
      </div>

    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <!-- ============================== Footer ============================== -->
    <footer class="w-full bg-surface-container-lowest border-t border-outline-variant/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-x-8 gap-y-10">
          <!-- Brand column -->
          <div class="lg:col-span-2 flex flex-col gap-3">
            <a href={`/${lang}`} class="inline-flex items-center gap-3 min-h-[44px]" aria-label={t(translations, 'site.name')}>
              <span class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center text-on-primary shrink-0" aria-hidden="true">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" />
                </svg>
              </span>
              <span class="flex flex-col text-left">
                <span class="text-base font-bold text-on-surface leading-none">{t(translations, 'site.name')}</span>
                <span class="text-xs text-on-surface-variant mt-0.5">{t(translations, 'site.tagline')}</span>
              </span>
            </a>
            <p class="text-[13px] text-on-surface-variant leading-relaxed max-w-sm">
              {t(translations, 'site.description')}
            </p>
            <div class="inline-flex items-center gap-2 mt-1">
              <span class="pmr-status-dot" aria-hidden="true"></span>
              <span class="text-[11px] font-mono uppercase tracking-wider text-secondary font-semibold">
                {t(translations, 'footer.client_side_note')}
              </span>
            </div>
          </div>

          <!-- Product column -->
          <div>
            <h4 class="text-[13px] font-semibold text-on-surface mb-4">{t(translations, 'footer.product_title')}</h4>
            <ul class="flex flex-col gap-2.5 text-[13px]">
              <li><a href={`/${lang}/`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'footer.main_tool')}</a></li>
              <li><a href={`/${lang}/formats`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.metadata')}</a></li>
