---
import '../styles/global.css';
import { getTranslations, t } from '../i18n/index';
import { SUPPORTED_LANGS, LANG_LABELS } from '../lib/lang';
import { isAnalyticsEnabled } from '../lib/analytics';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
}

const {
  title = 'Photo Metadata Remover',
  description = 'Remove EXIF data from your photos. Privacy-first, free, no uploads.',
  lang = 'en',
  ogType = 'website',
  jsonLd,
} = Astro.props;

const currentLang = ((SUPPORTED_LANGS as readonly string[]).includes(lang) ? lang : 'en') as 'en' | 'de' | 'fr';
const translations = getTranslations(currentLang);
const siteName = t(translations, 'site.name');

const SITE_URL = (Astro.site?.origin ?? 'https://photometadataremover.com').replace(/\/$/, '');

const analyticsEnabled = isAnalyticsEnabled();
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined;
const plausibleScriptSrc =
  (import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_SRC as string | undefined) ?? 'https://plausible.io/js/script.js';
const plausibleApiHost = import.meta.env.PUBLIC_PLAUSIBLE_API_HOST as string | undefined;

const pathWithoutLocale = Astro.url.pathname
  .replace(/^\/(en|de|fr)(?=\/|$)/, '')
  .replace(/\/$/, '') || '/';

const switchHref = (l: string) => `/${l}${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`;

const fullTitle = `${title} | ${siteName}`;

const localize = (l: string) => `${SITE_URL}/${l}${pathWithoutLocale === '/' ? '/' : pathWithoutLocale}`;
const canonicalUrl = localize(currentLang);

const ogImageUrl = `${SITE_URL}/og-image.png`;

const ogLocale = { en: 'en_US', de: 'de_DE', fr: 'fr_FR' }[currentLang];

const jsonLdBlocks = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

// Privacy badge copy — localized, with a safe fallback
const privacyBadgeText = t(translations, 'nav.client_side_badge');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f7f9f7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={localize('en')} />
    <link rel="alternate" hreflang="de" href={localize('de')} />
    <link rel="alternate" hreflang="fr" href={localize('fr')} />
    <link rel="alternate" hreflang="x-default" href={localize('en')} />

    <title>{fullTitle}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={t(translations, 'seo.og_image_alt')} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={t(translations, 'seo.og_image_alt')} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {analyticsEnabled && (
      <script
        defer
        data-domain={plausibleDomain}
        data-api={plausibleApiHost ? `${plausibleApiHost.replace(/\/$/, '')}/api/event` : undefined}
        src={plausibleScriptSrc}
      />
    )}

    <!-- Fonts — Inter per the PhotoGuard design -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-bg text-text antialiased">
    <!-- Skip to content link for keyboard / screen-reader users -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:px-4 focus:py-2 focus:bg-surface focus:text-text focus:border focus:border-border focus:rounded-lg focus:text-sm focus:font-medium"
    >
      {t(translations, 'nav.skip_to_content')}
    </a>

    <!-- ============================== Navigation ============================== -->
    <nav
      class="sticky top-0 left-0 right-0 z-50 bg-surface-container-lowest/80 backdrop-blur-xl border-b border-outline-variant/30 relative"
      aria-label="Primary"
    >
      <div id="nav-fit" class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 min-h-20 flex flex-nowrap items-center justify-between gap-2 sm:gap-4">
        <!-- Brand logo & title -->
        <a href={`/${lang}`} class="flex items-center gap-3.5 group shrink max-w-[45%]" aria-label={t(translations, 'site.name')}>
          <span
            class="w-11 h-11 rounded-xl bg-primary flex items-center justify-center text-on-primary shadow-sm transition-transform group-hover:scale-105"
            aria-hidden="true"
          >
            <!-- Camera icon (privacy-guard aesthetic) -->
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" />
            </svg>
          </span>
          <span class="flex flex-col min-w-0">
            <span class="text-lg sm:text-xl font-bold text-on-surface tracking-tight leading-none truncate">
              {t(translations, 'site.name')}
            </span>
            <span class="block text-xs text-on-surface-variant font-medium mt-0.5 truncate">
              {t(translations, 'site.tagline')}
            </span>
          </span>
        </a>

        <!-- Desktop navigation menu (always visible; the single navbar row pans
             horizontally on narrow viewports instead of wrapping) -->
        <div class="flex flex-nowrap items-center gap-x-5 text-sm font-medium text-on-surface-variant whitespace-nowrap">
          <a href={`/${lang}/`} class="text-on-surface font-semibold hover:text-on-surface transition-colors">{t(translations, 'nav.home')}</a>
          <a href={`/${lang}/formats`} class="hover:text-on-surface transition-colors">{t(translations, 'nav.metadata')}</a>
          <a href={`/${lang}/guides`} class="hover:text-on-surface transition-colors">{t(translations, 'nav.guides')}</a>
          <a href={`/${lang}/faq`} class="hover:text-on-surface transition-colors">{t(translations, 'nav.faq')}</a>
          <a href={`/${lang}/about`} class="hover:text-on-surface transition-colors">{t(translations, 'nav.about')}</a>
          <a href={`/${lang}/privacy`} class="hover:text-on-surface transition-colors">{t(translations, 'nav.privacy')}</a>
        </div>

        <!-- RIGHT (always): language + GitHub + primary CTA + mobile menu -->
        <div class="flex flex-nowrap items-center gap-2 shrink-0">
          <!-- Theme toggle (sun icon) — light theme only, per Stitch -->
          <button
            id="theme-toggle"
            type="button"
            aria-label={t(translations, 'nav.toggle_theme')}
            class="inline-flex w-10 h-10 rounded-full border border-outline-variant/50 flex items-center justify-center text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low transition-colors"
          >
            <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="5" />
              <line x1="12" x2="12" y1="1" y2="3" />
              <line x1="12" x2="12" y1="21" y2="23" />
              <line x1="4.22" x2="5.64" y1="4.22" y2="5.64" />
              <line x1="18.36" x2="19.78" y1="18.36" y2="19.78" />
              <line x1="1" x2="3" y1="12" y2="12" />
              <line x1="21" x2="23" y1="12" y2="12" />
              <line x1="4.22" x2="5.64" y1="19.78" y2="18.36" />
              <line x1="18.36" x2="19.78" y1="5.64" y2="4.22" />
            </svg>
          </button>

          <!-- Language Switcher -->
          <div>
            <button
              id="lang-toggle"
              type="button"
              class="inline-flex items-center gap-1 h-11 px-2.5 text-[13px] text-on-surface-variant hover:text-on-surface transition-colors rounded-lg hover:bg-surface-container-low"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label={t(translations, 'nav.change_language')}
              aria-controls="lang-dropdown"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              <span class="uppercase font-medium tracking-wide">{currentLang}</span>
            </button>
            </div>

          <!-- GitHub/Open Source pill -->
          <a
            href="https://github.com"
            rel="noopener noreferrer"
            target="_blank"
            class="inline-flex items-center gap-2 h-11 px-4 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface border border-outline-variant/50 text-sm font-medium transition-all duration-150"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            <span>{t(translations, 'nav.open_source')}</span>
          </a>

          <!-- Primary CTA — "Remove Now" (localized, preserves existing routing) -->
          <a
            id="nav-cta"
            href={`/${lang}/`}
            class="inline-flex items-center gap-1.5 h-11 px-4 sm:px-5 rounded-full bg-primary text-on-primary text-[13px] font-medium whitespace-nowrap hover:bg-primary-container transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2" />
            </svg>
            <span class="hidden sm:inline">{t(translations, 'nav.remove_now')}</span>
            <span class="sm:hidden" aria-hidden="true">{t(translations, 'nav.remove_now_short')}</span>
          </a>

          </div>
      </div>

      <!-- Language dropdown — kept outside the scrollable navbar row so it is
           never clipped by the internal scroll container -->
      <div
        id="lang-dropdown"
        class="hidden absolute right-0 top-full mt-2 w-40 bg-surface-container-lowest rounded-xl shadow-lg border border-outline-variant/50 py-1.5 z-50 pmr-elev-2"
        role="menu"
        aria-label={t(translations, 'nav.change_language')}
      >
        {SUPPORTED_LANGS.map((l) => (
          <a
            href={switchHref(l)}
            hreflang={l}
            lang={l}
            data-lang-switch={l}
            aria-current={currentLang === l ? 'page' : undefined}
            class={`block px-3 py-2 min-h-[44px] text-[13.5px] hover:bg-surface-container-low transition-colors ${currentLang === l ? 'text-secondary font-medium' : 'text-on-surface'}`}
            role="menuitem"
          >
            {LANG_LABELS[l]}
          </a>
        ))}
      </div>
    </nav>

    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <!-- ============================== Footer ============================== -->
    <footer class="w-full bg-surface-container-lowest border-t border-outline-variant/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-x-8 gap-y-10">
          <!-- Brand column -->
          <div class="lg:col-span-2 flex flex-col gap-3">
            <a href={`/${lang}`} class="inline-flex items-center gap-3 min-h-[44px]" aria-label={t(translations, 'site.name')}>
              <span class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center text-on-primary shrink-0" aria-hidden="true">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" />
                </svg>
              </span>
              <span class="flex flex-col text-left">
                <span class="text-base font-bold text-on-surface leading-none">{t(translations, 'site.name')}</span>
                <span class="text-xs text-on-surface-variant mt-0.5">{t(translations, 'site.tagline')}</span>
              </span>
            </a>
            <p class="text-[13px] text-on-surface-variant leading-relaxed max-w-sm">
              {t(translations, 'site.description')}
            </p>
            <div class="inline-flex items-center gap-2 mt-1">
              <span class="pmr-status-dot" aria-hidden="true"></span>
              <span class="text-[11px] font-mono uppercase tracking-wider text-secondary font-semibold">
                {t(translations, 'footer.client_side_note')}
              </span>
            </div>
          </div>

          <!-- Product column -->
          <div>
            <h4 class="text-[13px] font-semibold text-on-surface mb-4">{t(translations, 'footer.product_title')}</h4>
            <ul class="flex flex-col gap-2.5 text-[13px]">
              <li><a href={`/${lang}/`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'footer.main_tool')}</a></li>
              <li><a href={`/${lang}/formats`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.metadata')}</a></li>
              <li><a href={`/${lang}/guides`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.guides')}</a></li>
              <li><a href={`/${lang}/faq`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.faq')}</a></li>
            </ul>
          </div>

          <!-- Information column -->
          <div>
            <h4 class="text-[13px] font-semibold text-on-surface mb-4">{t(translations, 'footer.info_title')}</h4>
            <ul class="flex flex-col gap-2.5 text-[13px]">
              <li><a href={`/${lang}/about`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.about')}</a></li>
              <li><a href={`/${lang}/how-it-works`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.how_it_works')}</a></li>
              <li><a href={`/${lang}/privacy`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'footer.privacy')}</a></li>
              <li><a href={`/${lang}/security`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.security')}</a></li>
              <li><a href={`/${lang}/formats`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.formats')}</a></li>
              <li><a href={`/${lang}/faq`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.faq')}</a></li>
              <li><a href={`/${lang}/open-source`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.open_source')}</a></li>
              <li><a href={`/${lang}/legal`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'footer.legal_hub')}</a></li>
            </ul>
          </div>

          <!-- Trust & languages column -->
          <div>
            <h4 class="text-[13px] font-semibold text-on-surface mb-4">{t(translations, 'footer.trust_title')}</h4>
            <ul class="flex flex-col gap-2.5 text-[13px] text-on-surface-variant">
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0 mt-[7px]" aria-hidden="true"></span>
                <span>{t(translations, 'footer.trust.0')}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0 mt-[7px]" aria-hidden="true"></span>
                <span>{t(translations, 'footer.trust.1')}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0 mt-[7px]" aria-hidden="true"></span>
                <span>{t(translations, 'footer.trust.2')}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0 mt-[7px]" aria-hidden="true"></span>
                <span>{t(translations, 'footer.trust.3')}</span>
              </li>
            </ul>

            <div class="mt-5 pt-3 border-t border-outline-variant/30">
              <div class="text-[11px] font-mono uppercase tracking-wider text-on-surface-variant mb-2">
                {t(translations, 'footer.languages')}
              </div>
              <div class="flex flex-wrap gap-2 text-[13px] font-medium">
                {SUPPORTED_LANGS.map((l) => (
                  <a
                    href={`/${l}/`}
                    hreflang={l}
                    lang={l}
                    data-lang-switch={l}
                    class={`min-h-[44px] inline-flex px-3 py-1.5 rounded-lg border transition-colors ${currentLang === l ? 'border-outline-variant/60 bg-surface-container-low text-on-surface font-semibold' : 'border-outline-variant/40 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low'}`}
                  >
                    {LANG_LABELS[l]}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Legal links (preserved real routes) -->
        <div class="flex flex-wrap items-center justify-center gap-x-6 pt-5 mt-5 text-xs text-on-surface-variant">
          <a href={`/${lang}/privacy`} class="hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'footer.privacy')}</a>
          <a href={`/${lang}/terms`} class="hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'footer.terms')}</a>
          <a href={`/${lang}/impressum`} class="hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'footer.impressum')}</a>
          <a href={`/${lang}/contact`} class="hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'footer.contact')}</a>
        </div>

        <!-- Bottom copyright row -->
        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-on-surface-variant gap-4">
          <p>{t(translations, 'footer.copyright')}</p>
          <p>{t(translations, 'footer.made_with_line')}</p>
        </div>
      </div>
    </footer>

    <script>
      import { saveLang, isLang } from '../lib/lang';
      import { trackEvent } from '../lib/analytics';

      // Language dropdown toggle
      const langToggle = document.getElementById('lang-toggle');
      const langDropdown = document.getElementById('lang-dropdown');

      const setLangExpanded = (expanded: boolean) => {
        langToggle?.setAttribute('aria-expanded', String(expanded));
      };

      langToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const opened = langDropdown?.classList.toggle('hidden') === false;
        setLangExpanded(opened);
      });

      // Persist the user's manual language choice
      document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) => {
        link.addEventListener('click', () => {
          const target = link.getAttribute('data-lang-switch');
          if (isLang(target)) {
            saveLang(target);
            trackEvent('language_switch', { from: document.documentElement.lang || 'en', to: target });
          }
        });
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!langToggle?.contains(e.target as Node) && !langDropdown?.contains(e.target as Node)) {
          langDropdown?.classList.add('hidden');
          setLangExpanded(false);
        }
      });

      // Escape closes the language dropdown, then returns focus
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (langDropdown && !langDropdown.classList.contains('hidden')) {
          langDropdown.classList.add('hidden');
          setLangExpanded(false);
          langToggle?.focus();
        }
      });
    </script>
  </body>
</html>
