              <li><a href={`/${lang}/privacy`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'footer.privacy')}</a></li>
              <li><a href={`/${lang}/security`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.security')}</a></li>
              <li><a href={`/${lang}/formats`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.formats')}</a></li>
              <li><a href={`/${lang}/faq`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'nav.faq')}</a></li>
              <li><a href={`/${lang}/legal`} class="text-on-surface-variant hover:text-on-surface transition-colors min-h-[44px] inline-flex">{t(translations, 'footer.legal_hub')}</a></li>
