    </footer>

    <script>
      import { saveLang, isLang } from '../lib/lang';
      import { trackEvent } from '../lib/analytics';

      // Language dropdown toggle
      const langToggle = document.getElementById('lang-toggle');
      const langDropdown = document.getElementById('lang-dropdown');

      const setLangExpanded = (expanded: boolean) => {
        langToggle?.setAttribute('aria-expanded', String(expanded));
      };

      langToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const opened = langDropdown?.classList.toggle('hidden') === false;
        setLangExpanded(opened);
      });

      // Persist the user's manual language choice
      document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) => {
        link.addEventListener('click', () => {
          const target = link.getAttribute('data-lang-switch');
          if (isLang(target)) {
            saveLang(target);
            trackEvent('language_switch', { from: document.documentElement.lang || 'en', to: target });
          }
        });
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!langToggle?.contains(e.target as Node) && !langDropdown?.contains(e.target as Node)) {
          langDropdown?.classList.add('hidden');
          setLangExpanded(false);
        }
      });

      // Escape closes the language dropdown, then returns focus
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (langDropdown && !langDropdown.classList.contains('hidden')) {
          langDropdown.classList.add('hidden');
          setLangExpanded(false);
          langToggle?.focus();
        }
      });

      /* ------------------------------------------------------------------
       * Mobile / tablet navigation drawer (Google Stitch).
       * Phone + tablet only. The trigger is `lg:hidden`, so on desktop this
       * block can never run. Language switching is NOT reimplemented: the
       * drawer reuses switchHref() hrefs and the data-lang-switch hooks bound
       * above, so localStorage.pmr_lang, the cookie and analytics behave
       * exactly as they already do.
       * --------------------------------------------------------------- */
      const drawer = document.getElementById('mobile-menu');
      const drawerToggle = document.getElementById('mobile-menu-toggle');
      const drawerClose = drawer?.querySelector<HTMLElement>('.pmr-drawer-close');
      const drawerBackdrop = drawer?.querySelector<HTMLElement>('.pmr-drawer-backdrop');

      const drawerIsOpen = () => !!drawer && !drawer.classList.contains('hidden');

      const setDrawer = (open: boolean) => {
        if (!drawer || !drawerToggle) return;
        drawer.classList.toggle('hidden', !open);
        drawerToggle.setAttribute('aria-expanded', String(open));
        // Freeze the page behind the drawer; released again on close.
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) {
          drawerClose?.focus();
        } else {
          drawerToggle.focus();
        }
      };

      drawerToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        setDrawer(!drawerIsOpen());
      });

      drawerClose?.addEventListener('click', (e) => {
        e.stopPropagation();
        setDrawer(false);
      });

      drawerBackdrop?.addEventListener('click', (e) => {
        e.stopPropagation();
        setDrawer(false);
      });

      // Drawer links.
      //
      // CRITICAL: the browser's default navigation (the anchor's "activation
      // behaviour") must be left completely undisturbed. Hiding the drawer
      // synchronously inside this handler sets `display: none` on #mobile-menu
      // — the very container of the anchor being activated — which cancels
      // that activation on some browsers/devices, so the tap silently does
      // nothing. Calling .focus() at the same time also fights the click.
      //
      // Page links navigate away, so the whole document (drawer included) is
      // replaced by the browser anyway — no close is required. We therefore
      // never touch the drawer during the click itself.
      drawer?.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
        link.addEventListener('click', (e) => {
          if (!drawerIsOpen()) return;
          const href = link.getAttribute('href') ?? '';
          if (!href.startsWith('#')) return; // real page: let the browser navigate
          // Same-document link: no navigation to wait for, so close immediately.
          e.preventDefault();
          setDrawer(false);
          const target = document.getElementById(href.slice(1));
          if (target) {
            target.scrollIntoView();
            history.replaceState(null, '', href);
          }
        });
      });

      // Escape closes the drawer and returns focus to the hamburger.
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !drawerIsOpen()) return;
        setDrawer(false);
      });

      // Keep Tab focus inside the drawer while it is open.
      drawer?.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab' || !drawerIsOpen()) return;
        const focusables = Array.from(
          drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
        ).filter((el) => el.offsetParent !== null);
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });

      // Leaving the mobile/tablet range (or arriving at desktop) closes the
      // drawer, so the desktop navbar is never left covered or scroll-locked.
      const desktopRange = window.matchMedia('(min-width: 1024px)');
      const closeOnDesktop = (e: MediaQueryList | MediaQueryListEvent) => {
        if (e.matches && drawerIsOpen()) {
          drawer?.classList.add('hidden');
          drawerToggle?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }
      };
      desktopRange.addEventListener('change', closeOnDesktop);
      closeOnDesktop(desktopRange);
    </script>
  </body>
</html>
