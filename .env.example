# Legal identity for the /impressum and /contact pages (used in legal.ts).
# Required: at least PUBLIC_LEGAL_NAME, PUBLIC_LEGAL_ADDRESS, PUBLIC_LEGAL_EMAIL.
# If any of those three is missing, the impression/contact pages show a
# localized "not configured" notice instead of legal details.
# PUBLIC_LEGAL_REPRESENTATIVE and PUBLIC_LEGAL_VAT only render when set.
# Do not commit a real .env file (it is git-ignored).
PUBLIC_LEGAL_NAME=
PUBLIC_LEGAL_ADDRESS=
PUBLIC_LEGAL_EMAIL=
PUBLIC_LEGAL_REPRESENTATIVE=
PUBLIC_LEGAL_VAT=

# Plausible analytics. Leave PUBLIC_PLAUSIBLE_DOMAIN empty (or unset) to
# disable analytics entirely: no script is loaded and trackEvent() no-ops.
# It should contain the site's Plausible domain (e.g. photometadataremover.com)
# to enable anonymized, cookieless analytics. Image files/metadata are never sent.
PUBLIC_PLAUSIBLE_DOMAIN=
# Optional overrides (proxy/self-hosted setups only):
# PUBLIC_PLAUSIBLE_SCRIPT_SRC=
# PUBLIC_PLAUSIBLE_API_HOST=